# Platform JWT security secret. Change this in production and keep it in sync with backend Jwt:Key.
JWT_SECRET=factory-jwt-secret-key-1234-long-enough-32bytes

# Database Configuration
POSTGRES_DB=factory_db
POSTGRES_USER=factory_user
POSTGRES_PASSWORD=factory_secure_password_9988
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Storage Configuration
MINIO_ROOT_USER=minio_admin
MINIO_ROOT_PASSWORD=minio_secure_password_7788
MINIO_SECURE=false

# Service Endpoints
GATEWAY_PORT=8080
BRIDGE_PORT=8081
DOCUMENT_SERVICE_PORT=8082
REPORT_SERVICE_PORT=8083
BACKEND_URL=http://host.docker.internal:5000
DOCUMENT_SERVICE_URL=http://document-service:8082
REPORT_SERVICE_URL=http://report-service:8083

# LLM Configuration
LLM_API_URL=http://host.docker.internal:7000/v1
LLM_API_KEY=your-api-key
LLM_MODEL=gpt-4o-mini

# Backend service account used by gateway for authenticated backend endpoints.
AI_SERVICE_USER=ai_service
AI_SERVICE_PASSWORD=change-me-ai-service-password

# Document RAG
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DIMS=384

# Agent Configuration
MOCK_ANTIGRAVITY=true
