# Local/demo example only. Production deployments must use DEPLOYMENT_MODE=production,
# live integrations, deployment-specific endpoints, and secret-manager values.
DEPLOYMENT_MODE=local-demo

# Inject secret values at deploy time; do not commit real values.
JWT_SECRET=

# Database Configuration
POSTGRES_DB=factory_db
POSTGRES_USER=factory_user
POSTGRES_PASSWORD=
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
ASSET_DATABASE_URL=
ASSET_SYNC_DATABASE_URL=
CEP_POSTGRES_URL=
CONNECTOR_API_KEY=
CONNECTOR_CORS_ORIGINS=

# Storage Configuration
MINIO_ROOT_USER=minio_admin
MINIO_ROOT_PASSWORD=
MINIO_SECURE=false

# Service Endpoints
GATEWAY_PORT=8080
BRIDGE_PORT=8081
DOCUMENT_SERVICE_PORT=8082
REPORT_SERVICE_PORT=8083
BACKEND_URL=http://host.docker.internal:5000
ANTIGRAVITY_BRIDGE_URL=http://antigravity-bridge:8081
DOCUMENT_SERVICE_URL=http://document-service:8082
REPORT_SERVICE_URL=http://report-service:8083
REPORT_SERVICE_API_KEY=
REPORT_DOWNLOAD_SIGNING_KEY=
REPORT_PUBLIC_BASE_URL=https://reports.your-domain.invalid
REPORT_PUBLIC_HOST_ALLOWLIST=reports.your-domain.invalid

# LLM Configuration
LLM_API_URL=http://host.docker.internal:7000/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini

# Backend service account used by gateway for authenticated backend endpoints.
AI_SERVICE_USER=ai_service
AI_SERVICE_PASSWORD=

# Document RAG
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DIMS=384

# Agent Configuration
MOCK_ANTIGRAVITY=true
CEP_MODE=mock
# Restrict this to the one local workspace that the bridge may access.
ANTIGRAVITY_WORKSPACE_HOST_PATH=..
