# ============================================================
# Factory AI Platform — Environment Variables
# ============================================================
# Load these variables through your shell, a deployment secret store, or ASP.NET Core user-secrets.
# The backend does not automatically load a .env file.
# ============================================================

# ── Database ────────────────────────────────────────────────
# Used by infrastructure/timescaledb/docker-compose.yml only.
POSTGRES_PASSWORD=replace-with-a-strong-local-password

# ASP.NET Core reads nested keys through double-underscore environment variables.
ConnectionStrings__DefaultConnection=Host=localhost;Port=5432;Database=plc_monitoring;Username=postgres;Password=replace-with-a-strong-local-password;Include Error Detail=true
ConnectionStrings__Timescale=Host=localhost;Port=55433;Database=plc_timescale;Username=postgres;Password=replace-with-a-strong-local-password

# ── JWT / Auth ──────────────────────────────────────────────
# Use a unique random value of at least 32 bytes in deployment.
Jwt__Key=replace-with-a-unique-random-secret-at-least-32-bytes

# ── MQTT Encryption ────────────────────────────────────────
# Must be set before the backend starts.
Mqtt__EncryptionKey=replace-with-a-unique-mqtt-encryption-key

# ── TimescaleDB ─────────────────────────────────────────────
TIMESCALE_ENABLED=false

# ── CEP Staging ─────────────────────────────────────────────
CEP_STAGING_ENABLED=false
CEP_STAGING_URL=http://localhost:58085

# ── Open Data Fusion ────────────────────────────────────────
ODF_CAPTURE_ENABLED=false

# ── FII SSO ─────────────────────────────────────────────────
FII_SSO_SECURE_COOKIE=false
FII_SSO_COOKIE_DOMAIN=
