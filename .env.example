# ============================================================
# Factory AI Platform — Environment Variables
# ============================================================
# Copy to .env and fill in production values.
# Development defaults work with docker-compose as-is.
# ============================================================

# ── Database ────────────────────────────────────────────────
DB_PASSWORD=12345678
POSTGRES_PASSWORD=12345678

# ── JWT / Auth ──────────────────────────────────────────────
JWT_KEY=factory-jwt-secret-key-1234-long-enough-32bytes

# ── MQTT Encryption ────────────────────────────────────────
MQTT_ENCRYPTION_KEY=your-mqtt-encryption-key-here

# ── TimescaleDB ─────────────────────────────────────────────
TIMESCALE_ENABLED=false

# ── CEP Staging ─────────────────────────────────────────────
CEP_STAGING_ENABLED=false
CEP_STAGING_URL=http://localhost:58085

# ── Open Data Fusion ────────────────────────────────────────
ODF_CAPTURE_ENABLED=false

# ── FII SSO ─────────────────────────────────────────────────
FII_SSO_SECURE_COOKIE=false
FII_SSO_COOKIE_DOMAIN=
