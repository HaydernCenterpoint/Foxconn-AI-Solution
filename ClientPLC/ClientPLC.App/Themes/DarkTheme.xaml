<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- Base Backgrounds -->
    <SolidColorBrush x:Key="WindowBackground"           Color="#02051C"/>
    <SolidColorBrush x:Key="PanelBackground"            Color="#07112F"/>
    <SolidColorBrush x:Key="SidebarBackground"          Color="#07183B"/>
    <SolidColorBrush x:Key="SidebarHeaderBackground"    Color="#02051C"/>
    <SolidColorBrush x:Key="SidebarMenuBackground"      Color="#02051C"/>
    <SolidColorBrush x:Key="SidebarMenuHeaderBackground" Color="#07112F"/>
    <SolidColorBrush x:Key="SidebarBrandForeground"     Color="#FFFFFF"/>

    <!-- Borders -->
    <SolidColorBrush x:Key="BorderBrush"                Color="#1E3A8A"/>
    <SolidColorBrush x:Key="BorderLight"                Color="#1E3A8A"/>

    <!-- Text -->
    <SolidColorBrush x:Key="TextPrimary"                Color="#FFFFFF"/>
    <SolidColorBrush x:Key="TextSecondary"              Color="#B7C8E8"/>
    <SolidColorBrush x:Key="TextMuted"                  Color="#7183A8"/>
    <SolidColorBrush x:Key="SidebarText"                Color="#B7C8E8"/>
    <SolidColorBrush x:Key="SidebarTextActive"          Color="#2F7BFF"/>

    <!-- Accent — Neon Blue -->
    <SolidColorBrush x:Key="AccentColor"                Color="#2F7BFF"/>
    <Color x:Key="AccentColorVal">#2F7BFF</Color>
    <SolidColorBrush x:Key="AccentHover"                Color="#60A5FA"/>
    <SolidColorBrush x:Key="AccentPressed"              Color="#1E40AF"/>
    <SolidColorBrush x:Key="AccentLight"                Color="#1E3A8A"/>

    <!-- Inputs -->
    <SolidColorBrush x:Key="InputBackground"            Color="#07183B"/>
    <SolidColorBrush x:Key="InputBorder"                Color="#1E3A8A"/>
    <SolidColorBrush x:Key="InputForeground"            Color="#FFFFFF"/>
    <SolidColorBrush x:Key="InputSelection"             Color="#2563EB"/>

    <!-- Status Bar -->
    <SolidColorBrush x:Key="StatusBarBackground"        Color="#02051C"/>
    <SolidColorBrush x:Key="StatusBarForeground"        Color="#B7C8E8"/>

    <!-- Semantic Status Colors -->
    <SolidColorBrush x:Key="SuccessColor"               Color="#10B981"/>
    <SolidColorBrush x:Key="SuccessLight"               Color="#064E3B"/>
    <SolidColorBrush x:Key="WarningColor"               Color="#F59E0B"/>
    <SolidColorBrush x:Key="WarningLight"               Color="#78350F"/>
    <SolidColorBrush x:Key="DangerColor"                Color="#EF4444"/>
    <SolidColorBrush x:Key="DangerLight"                Color="#7F1D1D"/>
    <SolidColorBrush x:Key="InfoColor"                  Color="#3B82F6"/>
    <SolidColorBrush x:Key="InfoLight"                  Color="#1E3A8A"/>

    <!-- Chart Colors -->
    <SolidColorBrush x:Key="Chart1"                     Color="#2F7BFF"/>
    <SolidColorBrush x:Key="Chart2"                     Color="#10B981"/>
    <SolidColorBrush x:Key="Chart3"                     Color="#8B5CF6"/>
    <SolidColorBrush x:Key="Chart4"                     Color="#06B6D4"/>
    <SolidColorBrush x:Key="Chart5"                     Color="#F59E0B"/>

    <!-- Menu Colors -->
    <SolidColorBrush x:Key="MenuBackground"             Color="#07112F"/>
    <SolidColorBrush x:Key="MenuText"                   Color="#FFFFFF"/>
    <SolidColorBrush x:Key="MenuBorder"                 Color="#1E3A8A"/>
    <SolidColorBrush x:Key="MenuHoverBackground"        Color="#1E40AF"/>
    <SolidColorBrush x:Key="MenuPressedBackground"      Color="#2563EB"/>
    <SolidColorBrush x:Key="MenuSeparator"              Color="#1E3A8A"/>
    <SolidColorBrush x:Key="MenuShortcutText"           Color="#7183A8"/>
    <SolidColorBrush x:Key="MenuDisabledText"           Color="#64748B"/>

    <!-- Alarm Colors -->
    <SolidColorBrush x:Key="AlarmActiveBackground"      Color="#3A1A22"/>
    <SolidColorBrush x:Key="AlarmActiveForeground"      Color="#FF5C6C"/>
    <SolidColorBrush x:Key="AlarmTodayBackground"       Color="#3A2E1D"/>
    <SolidColorBrush x:Key="AlarmTodayForeground"       Color="#FFB020"/>

    <!-- Header Colors -->
    <SolidColorBrush x:Key="HeaderBackground"           Color="#07112F"/>
    <SolidColorBrush x:Key="HeaderForeground"           Color="#FFFFFF"/>
    <SolidColorBrush x:Key="HeaderMenuText"             Color="#B7C8E8"/>
    <SolidColorBrush x:Key="HeaderMenuTextActive"       Color="#FFFFFF"/>
    <SolidColorBrush x:Key="HeaderBorder"               Color="#1E3A8A"/>
    <SolidColorBrush x:Key="HeaderBadgeBackground"      Color="#1AFFFFFF"/>
    <SolidColorBrush x:Key="HeaderBadgeBorder"          Color="#26FFFFFF"/>
    <SolidColorBrush x:Key="HeaderBadgeText"            Color="#B7C8E8"/>
    <SolidColorBrush x:Key="HeaderBtnHoverBackground"   Color="#26FFFFFF"/>

    <!-- KPI Card Semantic Colors -->
    <SolidColorBrush x:Key="KpiProductionColor"         Color="#2F7BFF"/>
    <Color x:Key="KpiProductionColorVal">#2F7BFF</Color>
    <SolidColorBrush x:Key="KpiProductionGradientEnd"   Color="#06B6D4"/>
    <Color x:Key="KpiProductionGradientEndVal">#06B6D4</Color>

    <SolidColorBrush x:Key="KpiYieldColor"              Color="#10B981"/>
    <Color x:Key="KpiYieldColorVal">#10B981</Color>
    <SolidColorBrush x:Key="KpiYieldGradientEnd"        Color="#059669"/>
    <Color x:Key="KpiYieldGradientEndVal">#059669</Color>

    <SolidColorBrush x:Key="KpiUphColor"                Color="#8B5CF6"/>
    <Color x:Key="KpiUphColorVal">#8B5CF6</Color>
    <SolidColorBrush x:Key="KpiUphGradientEnd"          Color="#7C3AED"/>
    <Color x:Key="KpiUphGradientEndVal">#7C3AED</Color>

    <SolidColorBrush x:Key="KpiOeeColor"                Color="#F59E0B"/>
    <Color x:Key="KpiOeeColorVal">#F59E0B</Color>
    <SolidColorBrush x:Key="KpiOeeGradientEnd"          Color="#D97706"/>
    <Color x:Key="KpiOeeGradientEndVal">#D97706</Color>

    <SolidColorBrush x:Key="KpiAlarmColor"              Color="#EF4444"/>
    <Color x:Key="KpiAlarmColorVal">#EF4444</Color>
    <SolidColorBrush x:Key="KpiAlarmGradientEnd"        Color="#DC2626"/>
    <Color x:Key="KpiAlarmGradientEndVal">#DC2626</Color>

    <!-- Font Sizes -->
    <sys:Double x:Key="BaseFontSize">13</sys:Double>
    <sys:Double x:Key="HeaderFontSize">15</sys:Double>
    <sys:Double x:Key="TitleFontSize">19</sys:Double>
</ResourceDictionary>
