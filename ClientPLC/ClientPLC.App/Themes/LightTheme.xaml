<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- Base Backgrounds -->
    <SolidColorBrush x:Key="WindowBackground"           Color="#F5F7FA"/>
    <SolidColorBrush x:Key="PanelBackground"            Color="#FFFFFF"/>
    <SolidColorBrush x:Key="SidebarBackground"          Color="#E8EDF2"/>
    <SolidColorBrush x:Key="SidebarHeaderBackground"    Color="#D6DEE6"/>
    <SolidColorBrush x:Key="SidebarMenuBackground"      Color="#F5F7FA"/>
    <SolidColorBrush x:Key="SidebarMenuHeaderBackground" Color="#E8EDF2"/>
    <SolidColorBrush x:Key="SidebarBrandForeground"     Color="#0F172A"/>

    <!-- Borders -->
    <SolidColorBrush x:Key="BorderBrush"                Color="#C8D1DB"/>
    <SolidColorBrush x:Key="BorderLight"                Color="#E3E8EE"/>

    <!-- Text -->
    <SolidColorBrush x:Key="TextPrimary"                Color="#0F172A"/>
    <SolidColorBrush x:Key="TextSecondary"              Color="#475569"/>
    <SolidColorBrush x:Key="TextMuted"                  Color="#94A3B8"/>
    <SolidColorBrush x:Key="SidebarText"                Color="#475569"/>
    <SolidColorBrush x:Key="SidebarTextActive"          Color="#0078D4"/>

    <!-- Accent — Azure Blue -->
    <SolidColorBrush x:Key="AccentColor"                Color="#0078D4"/>
    <Color x:Key="AccentColorVal">#0078D4</Color>
    <SolidColorBrush x:Key="AccentHover"                Color="#106EBE"/>
    <SolidColorBrush x:Key="AccentPressed"              Color="#005A9E"/>
    <SolidColorBrush x:Key="AccentLight"                Color="#E6F2FA"/>

    <!-- Inputs -->
    <SolidColorBrush x:Key="InputBackground"            Color="#FFFFFF"/>
    <SolidColorBrush x:Key="InputBorder"                Color="#C8D1DB"/>
    <SolidColorBrush x:Key="InputForeground"            Color="#0F172A"/>
    <SolidColorBrush x:Key="InputSelection"             Color="#B4D7FF"/>

    <!-- Status Bar -->
    <SolidColorBrush x:Key="StatusBarBackground"        Color="#E8EDF2"/>
    <SolidColorBrush x:Key="StatusBarForeground"        Color="#0F172A"/>

    <!-- Semantic Status Colors -->
    <SolidColorBrush x:Key="SuccessColor"               Color="#107C10"/>
    <SolidColorBrush x:Key="SuccessLight"               Color="#DFF6DD"/>
    <SolidColorBrush x:Key="WarningColor"               Color="#F7630C"/>
    <SolidColorBrush x:Key="WarningLight"               Color="#FFF4EC"/>
    <SolidColorBrush x:Key="DangerColor"                Color="#D13438"/>
    <SolidColorBrush x:Key="DangerLight"                Color="#FDE7E9"/>
    <SolidColorBrush x:Key="InfoColor"                  Color="#0099BC"/>
    <SolidColorBrush x:Key="InfoLight"                  Color="#E0F5FA"/>

    <!-- Chart Colors -->
    <SolidColorBrush x:Key="Chart1"                     Color="#0078D4"/>
    <SolidColorBrush x:Key="Chart2"                     Color="#107C10"/>
    <SolidColorBrush x:Key="Chart3"                     Color="#8764B8"/>
    <SolidColorBrush x:Key="Chart4"                     Color="#00B7C3"/>
    <SolidColorBrush x:Key="Chart5"                     Color="#F7630C"/>

    <!-- Menu Colors -->
    <SolidColorBrush x:Key="MenuBackground"             Color="#FFFFFF"/>
    <SolidColorBrush x:Key="MenuText"                   Color="#0F172A"/>
    <SolidColorBrush x:Key="MenuBorder"                 Color="#C8D1DB"/>
    <SolidColorBrush x:Key="MenuHoverBackground"        Color="#F5F7FA"/>
    <SolidColorBrush x:Key="MenuPressedBackground"      Color="#E8EDF2"/>
    <SolidColorBrush x:Key="MenuSeparator"              Color="#E3E8EE"/>
    <SolidColorBrush x:Key="MenuShortcutText"           Color="#94A3B8"/>
    <SolidColorBrush x:Key="MenuDisabledText"           Color="#CBD5E1"/>

    <!-- Alarm Colors -->
    <SolidColorBrush x:Key="AlarmActiveBackground"      Color="#FDE7E9"/>
    <SolidColorBrush x:Key="AlarmActiveForeground"      Color="#D13438"/>
    <SolidColorBrush x:Key="AlarmTodayBackground"       Color="#FFF4EC"/>
    <SolidColorBrush x:Key="AlarmTodayForeground"       Color="#F7630C"/>

    <!-- Header Colors -->
    <SolidColorBrush x:Key="HeaderBackground"           Color="#008C95"/>
    <SolidColorBrush x:Key="HeaderForeground"           Color="#FFFFFF"/>
    <SolidColorBrush x:Key="HeaderMenuText"             Color="#B2DFDB"/>
    <SolidColorBrush x:Key="HeaderMenuTextActive"       Color="#FFFFFF"/>
    <SolidColorBrush x:Key="HeaderBorder"               Color="#26FFFFFF"/>
    <SolidColorBrush x:Key="HeaderBadgeBackground"      Color="#1AFFFFFF"/>
    <SolidColorBrush x:Key="HeaderBadgeBorder"          Color="#26FFFFFF"/>
    <SolidColorBrush x:Key="HeaderBadgeText"            Color="#E0F2F1"/>
    <SolidColorBrush x:Key="HeaderBtnHoverBackground"   Color="#26FFFFFF"/>

    <!-- KPI Card Semantic Colors -->
    <SolidColorBrush x:Key="KpiProductionColor"         Color="#0078D4"/>
    <Color x:Key="KpiProductionColorVal">#0078D4</Color>
    <SolidColorBrush x:Key="KpiProductionGradientEnd"   Color="#00B7C3"/>
    <Color x:Key="KpiProductionGradientEndVal">#00B7C3</Color>

    <SolidColorBrush x:Key="KpiYieldColor"              Color="#10B981"/>
    <Color x:Key="KpiYieldColorVal">#10B981</Color>
    <SolidColorBrush x:Key="KpiYieldGradientEnd"        Color="#059669"/>
    <Color x:Key="KpiYieldGradientEndVal">#059669</Color>

    <SolidColorBrush x:Key="KpiUphColor"                Color="#8764B8"/>
    <Color x:Key="KpiUphColorVal">#8764B8</Color>
    <SolidColorBrush x:Key="KpiUphGradientEnd"          Color="#6B46C1"/>
    <Color x:Key="KpiUphGradientEndVal">#6B46C1</Color>

    <SolidColorBrush x:Key="KpiOeeColor"                Color="#F59E0B"/>
    <Color x:Key="KpiOeeColorVal">#F59E0B</Color>
    <SolidColorBrush x:Key="KpiOeeGradientEnd"          Color="#D97706"/>
    <Color x:Key="KpiOeeGradientEndVal">#D97706</Color>

    <SolidColorBrush x:Key="KpiAlarmColor"              Color="#EF4444"/>
    <Color x:Key="KpiAlarmColorVal">#EF4444</Color>
    <SolidColorBrush x:Key="KpiAlarmGradientEnd"        Color="#D13438"/>
    <Color x:Key="KpiAlarmGradientEndVal">#D13438</Color>

    <!-- Font Sizes -->
    <sys:Double x:Key="BaseFontSize">13</sys:Double>
    <sys:Double x:Key="HeaderFontSize">15</sys:Double>
    <sys:Double x:Key="TitleFontSize">19</sys:Double>
</ResourceDictionary>
