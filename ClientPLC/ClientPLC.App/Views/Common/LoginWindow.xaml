<Window x:Class="PLC.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Đăng nhập hệ thống" 
        Height="310" Width="400"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent">
    <Window.Resources>
        <!-- Reusable Premium Button Style -->
        <Style TargetType="Button" x:Key="DialogBtnStyle">
            <Setter Property="TextElement.FontFamily" Value="Segoe UI, Inter, Roboto, Arial"/>
            <Setter Property="TextElement.FontSize" Value="{DynamicResource BaseFontSize}"/>
            <Setter Property="Background" Value="{DynamicResource PanelBackground}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="MinWidth" Value="90"/>
            <Setter Property="Margin" Value="5,0,5,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                Background="{TemplateBinding Background}"
                                Name="border">
                            <ContentPresenter Content="{TemplateBinding Content}"
                                              Margin="10,0,10,0"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource SidebarBackground}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Button" x:Key="DialogAccentBtnStyle" BasedOn="{StaticResource DialogBtnStyle}">
            <Setter Property="Background" Value="{DynamicResource AccentColor}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource AccentHover}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Border BorderThickness="1"
            BorderBrush="{DynamicResource BorderBrush}"
            Background="{DynamicResource WindowBackground}"
            CornerRadius="8"
            Margin="15"
            Padding="0">
        <Border.Effect>
            <DropShadowEffect BlurRadius="12" ShadowDepth="2" Color="#000000" Opacity="0.3"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Title Bar -->
                <RowDefinition Height="*"/>    <!-- Content -->
                <RowDefinition Height="Auto"/> <!-- Button Bar -->
            </Grid.RowDefinitions>

            <!-- Custom Title Bar -->
            <Border Grid.Row="0" 
                    Background="{DynamicResource SidebarBackground}" 
                    BorderThickness="0,0,0,1" 
                    BorderBrush="{DynamicResource BorderBrush}"
                    CornerRadius="8,8,0,0"
                    Padding="12,10,12,10">
                <Grid>
                    <TextBlock x:Name="TxtTitle" 
                               Text="ĐĂNG NHẬP HỆ THỐNG" 
                               FontWeight="Bold" 
                               FontSize="13"
                               Foreground="{DynamicResource TextPrimary}"/>
                    <Button x:Name="BtnCloseTitle" 
                            HorizontalAlignment="Right" 
                            Background="Transparent" 
                            Foreground="{DynamicResource TextSecondary}"
                            BorderThickness="0" 
                            Cursor="Hand"
                            Focusable="False">
                        <Path Data="{StaticResource IconWinClose}" Stroke="{DynamicResource TextSecondary}" StrokeThickness="1.5" Width="10" Height="10" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Button>
                </Grid>
            </Border>

            <!-- Form Content -->
            <StackPanel Grid.Row="1" Margin="20,15,20,15">
                <!-- Role Selection -->
                <StackPanel Margin="0,0,0,15">
                    <Label Name="LblRole" Content="Quyền truy cập (Role):" Foreground="{DynamicResource TextSecondary}" Padding="0,0,0,5" FontSize="12" FontWeight="SemiBold"/>
                    <ComboBox Name="CboRole" Height="32" VerticalContentAlignment="Center" Background="{DynamicResource InputBackground}" Foreground="{DynamicResource InputForeground}" BorderBrush="{DynamicResource InputBorder}" Padding="5,2,5,2">
                        <ComboBoxItem Name="CboItemGuest" Content="Khách (Guest)" IsSelected="True"/>
                        <ComboBoxItem Name="CboItemEngineer" Content="Kỹ sư (Engineer)"/>
                        <ComboBoxItem Name="CboItemAdmin" Content="Quản trị viên (Admin)"/>
                    </ComboBox>
                </StackPanel>
 
                <!-- Password Input -->
                <StackPanel Name="PnlPassword" Visibility="Collapsed">
                    <Label Name="LblPassword" Content="Mật khẩu (Password):" Foreground="{DynamicResource TextSecondary}" Padding="0,0,0,5" FontSize="12" FontWeight="SemiBold"/>
                    <PasswordBox Name="TxtPassword" PasswordChar="●" Height="32" VerticalContentAlignment="Center" Background="{DynamicResource InputBackground}" Foreground="{DynamicResource InputForeground}" BorderBrush="{DynamicResource InputBorder}" Padding="5,2,5,2"/>
                </StackPanel>
            </StackPanel>

            <!-- Button Area -->
            <Border Grid.Row="2" 
                    Background="{DynamicResource SidebarBackground}" 
                    BorderThickness="0,1,0,0" 
                    BorderBrush="{DynamicResource BorderBrush}"
                    CornerRadius="0,0,8,8"
                    Padding="10,8,10,8">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="BtnLogin" Content="Đăng nhập" Style="{StaticResource DialogAccentBtnStyle}" IsDefault="True"/>
                    <Button x:Name="BtnCancel" Content="Hủy" Style="{StaticResource DialogBtnStyle}" IsCancel="True"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
