<Window x:Class="PLC.Views.CustomMessageBoxWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Thông báo" 
        Height="220" Width="450"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent">
    <Window.Resources>
        <!-- Reusable Premium Button Style -->
        <Style TargetType="Button" x:Key="DialogBtnStyle">
            <Setter Property="TextElement.FontFamily" Value="Segoe UI, Inter, Roboto, Arial"/>
            <Setter Property="TextElement.FontSize" Value="{DynamicResource BaseFontSize}"/>
            <Setter Property="Background" Value="{DynamicResource PanelBackground}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="MinWidth" Value="80"/>
            <Setter Property="Margin" Value="5,0,5,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                Background="{TemplateBinding Background}"
                                Name="border">
                            <ContentPresenter Content="{TemplateBinding Content}"
                                              Margin="10,0,10,0"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource SidebarBackground}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Button" x:Key="DialogAccentBtnStyle" BasedOn="{StaticResource DialogBtnStyle}">
            <Setter Property="Background" Value="{DynamicResource AccentColor}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource AccentHover}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Border BorderThickness="1"
            BorderBrush="{DynamicResource BorderBrush}"
            Background="{DynamicResource WindowBackground}"
            CornerRadius="8"
            Margin="15"
            Padding="0">
        <Border.Effect>
            <DropShadowEffect BlurRadius="12" ShadowDepth="2" Color="#000000" Opacity="0.3"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Title Bar -->
                <RowDefinition Height="*"/>    <!-- Content -->
                <RowDefinition Height="Auto"/> <!-- Button Bar -->
            </Grid.RowDefinitions>

            <!-- Custom Title Bar -->
            <Border Grid.Row="0" 
                    Background="{DynamicResource SidebarBackground}" 
                    BorderThickness="0,0,0,1" 
                    BorderBrush="{DynamicResource BorderBrush}"
                    CornerRadius="8,8,0,0"
                    Padding="12,8,12,8">
                <Grid>
                    <TextBlock x:Name="TxtTitle" 
                               Text="Thông báo" 
                               FontWeight="Bold" 
                               FontSize="13"
                               Foreground="{DynamicResource TextPrimary}"/>
                    <Button x:Name="BtnCloseTitle" 
                            HorizontalAlignment="Right" 
                            Background="Transparent" 
                            Foreground="{DynamicResource TextSecondary}"
                            BorderThickness="0" 
                            Cursor="Hand"
                            Focusable="False">
                        <Path Data="{StaticResource IconWinClose}" Stroke="{DynamicResource TextSecondary}" StrokeThickness="1.5" Width="10" Height="10" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Button>
                </Grid>
            </Border>

            <!-- Message Area -->
            <Grid Grid.Row="1" Margin="15,10,15,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Path x:Name="MsgBoxIconPath" 
                      Data="{StaticResource IconInfo}" 
                      Stroke="{DynamicResource AccentColor}" StrokeThickness="2"
                      Width="28" Height="28" 
                      VerticalAlignment="Center" 
                      Margin="0,0,12,0" 
                      Stretch="Uniform"/>
                <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                    <TextBlock x:Name="TxtMessage" 
                               Text="Nội dung thông báo ở đây" 
                               TextWrapping="Wrap" 
                               FontSize="13" 
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource TextPrimary}"/>
                </ScrollViewer>
            </Grid>

            <!-- Button Area -->
            <Border Grid.Row="2" 
                    Background="{DynamicResource SidebarBackground}" 
                    BorderThickness="0,1,0,0" 
                    BorderBrush="{DynamicResource BorderBrush}"
                    CornerRadius="0,0,8,8"
                    Padding="10,8,10,8">
                <StackPanel x:Name="PnlButtons" 
                            Orientation="Horizontal" 
                            HorizontalAlignment="Right">
                    <!-- Buttons will be dynamically added or shown -->
                    <Button x:Name="BtnYes" Content="Có (Yes)" Style="{StaticResource DialogAccentBtnStyle}" Visibility="Collapsed"/>
                    <Button x:Name="BtnNo" Content="Không (No)" Style="{StaticResource DialogBtnStyle}" Visibility="Collapsed"/>
                    <Button x:Name="BtnOK" Content="Đồng ý (OK)" Style="{StaticResource DialogAccentBtnStyle}" Visibility="Visible"/>
                    <Button x:Name="BtnCancel" Content="Hủy (Cancel)" Style="{StaticResource DialogBtnStyle}" Visibility="Collapsed"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
