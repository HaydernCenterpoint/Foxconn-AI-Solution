                                        Text="12 px"
                                        FontWeight="Bold"
                                        Foreground="{av:DynamicResource TextPrimary}"
                                        Name="TxtFontSizeVal"
                                        Margin="10,0,0,0"
                                        VerticalAlignment="Center"
                                        av:Grid.Column="1" />
                                </av:Grid>
                                <av:Label Name="LblLang">Ngôn ngữ giao diện:</av:Label>
                                <av:ComboBox
                                    Name="CboLanguage"
                                    Margin="0,0,0,20">
                                    <av:ComboBoxItem
                                        Tag="vi">Tiếng Việt</av:ComboBoxItem>
                                    <av:ComboBoxItem
                                        Tag="en">English</av:ComboBoxItem>
                                    <av:ComboBoxItem
                                        Tag="zh">中文 (Chinese)</av:ComboBoxItem>
                                </av:ComboBox>
                                <av:Border
                                    BorderThickness="0,1,0,0"
                                    BorderBrush="{av:DynamicResource BorderBrush}"
                                    Margin="0,10,0,15" />
                                <av:Label Name="LblMachineName">Tên máy trạm (Machine Name):</av:Label>
                                <av:TextBox
                                    Name="TxtMachineName"
                                    Margin="0,0,0,12"
                                    xml:space="preserve" />
                                <av:Grid>
                                    <av:Grid.ColumnDefinitions>
                                        <av:ColumnDefinition
                                            Width="*" />
                                        <av:ColumnDefinition
                                            Width="*" />
                                    </av:Grid.ColumnDefinitions>
                                    <av:StackPanel
                                        Margin="0,0,10,0">
                                        <av:Label Name="LblLineId">Mã chuyền (Line ID):</av:Label>
                                        <av:TextBox
                                            Name="TxtLineId"
                                            Margin="0,0,0,12"
                                            xml:space="preserve" />
                                    </av:StackPanel>
                                    <av:StackPanel
                                        Margin="10,0,0,0"
                                        av:Grid.Column="1">
                                        <av:Label Name="LblLineName">Tên chuyền (Line Name):</av:Label>
                                        <av:TextBox
                                            Name="TxtLineName"
                                            Margin="0,0,0,12"
                                            xml:space="preserve" />
                                    </av:StackPanel>
                                </av:Grid>
                                <av:Grid>
                                    <av:Grid.ColumnDefinitions>
                                        <av:ColumnDefinition
                                            Width="*" />
                                        <av:ColumnDefinition
                                            Width="*" />
                                    </av:Grid.ColumnDefinitions>
                                    <av:StackPanel
                                        Margin="0,0,10,0">
                                        <av:Label Name="LblLineOrder">Thứ tự máy:</av:Label>
                                        <av:TextBox
                                            Name="TxtLineOrder"
                                            Margin="0,0,0,12"
                                            xml:space="preserve" />
                                    </av:StackPanel>
                                    <av:StackPanel
                                        Margin="10,0,0,0"
                                        av:Grid.Column="1">
                                        <av:Label Name="LblMachineId">ID máy (Chỉ đọc):</av:Label>
                                        <av:TextBox
                                            IsReadOnly="True"
                                            Name="TxtMachineId"
                                            Margin="0,0,0,12"
                                            Opacity="0.6"
                                            xml:space="preserve" />
                                    </av:StackPanel>
                                </av:Grid>
                                <av:CheckBox
                                    Name="ChkUseMockData"
                                    Content="Sử dụng dữ liệu ảo (Demo Mode)"
                                    Foreground="{av:DynamicResource TextPrimary}"
                                    Margin="0,5,0,15"
                                    Height="25"
                                    VerticalContentAlignment="Center" />
                            </av:StackPanel>
                        </av:Grid>
                    </av:ScrollViewer>
                </av:TabItem>
