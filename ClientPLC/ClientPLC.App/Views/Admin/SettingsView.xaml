            Text="CẤU HÌNH HỆ THỐNG &amp; THIẾT BỊ"
            FontWeight="Bold"
            FontSize="{av:DynamicResource TitleFontSize}"
            Foreground="{av:DynamicResource TextPrimary}"
            Name="TxtTitle"
            Margin="0,0,0,15"
            Visibility="Collapsed"
            av:Grid.Row="0" />
        <av:Border
            BorderThickness="1,1,1,1"
            Padding="15,15,15,15"
            CornerRadius="4,4,4,4"
            BorderBrush="{av:DynamicResource BorderBrush}"
            Background="{av:DynamicResource PanelBackground}"
            av:Grid.Row="1">
