                                                    </av:Setter.Value>
                                                </av:Setter>
                                                <av:Setter
                                                    Property="av:Panel.Background">
                                                    <av:Setter.Value>
                                                        <av:DynamicResource
                                                            ResourceKey="PanelBackground" />
                                                    </av:Setter.Value>
                                                </av:Setter>
                                                <av:Trigger.Value>
                                                    <s:Boolean>True</s:Boolean>
                                                </av:Trigger.Value>
                                            </av:Trigger>
                                        </av:ControlTemplate.Triggers>
                                    </av:ControlTemplate>
                                </av:Setter.Value>
                            </av:Setter>
                        </av:Style>
                    </av:TabItem.Style>
                    <av:Grid
                        Margin="15,15,15,15">
                        <av:Grid.RowDefinitions>
                            <av:RowDefinition
                                Height="Auto" />
                            <av:RowDefinition
                                Height="Auto" />
                            <av:RowDefinition
                                Height="*" />
                        </av:Grid.RowDefinitions>
                        <av:TextBlock
                            Text="Chọn các hãng PLC muốn hiển thị trên danh mục Sidebar:"
                            FontSize="{av:DynamicResource BaseFontSize}"
                            Foreground="{av:DynamicResource TextSecondary}"
                            Name="TxtBrandVisHelp"
                            Margin="0,0,0,10"
                            av:Grid.Row="0" />
                        <av:StackPanel
                            Orientation="Horizontal"
                            Margin="0,0,0,15"
                            av:Grid.Row="1">
                            <av:Button
                                Content="Bật tất cả"
                                Name="BtnSelectAllBrands"
                                Padding="15,0,15,0"
                                Height="28"
                                Margin="0,0,10,0"
