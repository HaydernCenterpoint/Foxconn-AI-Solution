                            VerticalScrollBarVisibility="Auto"
                            av:Grid.Row="2">
                            <av:WrapPanel
                                ItemWidth="200"
                                Name="PanelBrandsCheckboxes"
                                Margin="0,0,0,15" />
                        </av:ScrollViewer>
