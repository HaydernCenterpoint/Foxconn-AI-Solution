<av:UserControl x:Class="PLC.Views.SettingsView"
    Background="#00FFFFFF"
    xmlns="clr-namespace:PLC.Views;assembly=ClientPLC"
    xmlns:av="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:s="clr-namespace:System;assembly=mscorlib"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <av:UserControl.Resources>
        <av:Style
            TargetType="av:TabItem"
            x:Key="TabHeaderStyle">
            <av:Style.Resources>
                <av:ResourceDictionary />
            </av:Style.Resources>
            <av:Setter
                Property="av:TextElement.Foreground">
                <av:Setter.Value>
                    <av:DynamicResource
                        ResourceKey="TextSecondary" />
                </av:Setter.Value>
            </av:Setter>
            <av:Setter
                Property="av:Panel.Background">
                <av:Setter.Value>
                    <av:DynamicResource
                        ResourceKey="WindowBackground" />
                </av:Setter.Value>
            </av:Setter>
            <av:Setter
                Property="av:Control.Padding">
                <av:Setter.Value>
                    <av:Thickness>18,10,18,10</av:Thickness>
                </av:Setter.Value>
            </av:Setter>
            <av:Setter
                Property="av:TextElement.FontWeight">
                <av:Setter.Value>
                    <av:FontWeight>SemiBold</av:FontWeight>
                </av:Setter.Value>
            </av:Setter>
            <av:Setter
                Property="av:TextElement.FontSize">
                <av:Setter.Value>
                    <av:DynamicResource
                        ResourceKey="BaseFontSize" />
                </av:Setter.Value>
            </av:Setter>
            <av:Setter
                Property="av:Control.Template">
                <av:Setter.Value>
                    <av:ControlTemplate
                        TargetType="av:TabItem">
                        <av:Border
                            BorderThickness="0,0,0,3"
                            CornerRadius="4,4,0,0"
                            BorderBrush="#00FFFFFF"
                            Background="{av:TemplateBinding av:Panel.Background}"
                            Name="border"
                            Margin="0,0,2,0">
                            <av:ContentPresenter
                                Content="{av:TemplateBinding av:HeaderedContentControl.Header}"
                                ContentTemplate="{av:TemplateBinding av:HeaderedContentControl.HeaderTemplate}"
                                ContentStringFormat="{av:TemplateBinding av:HeaderedContentControl.HeaderStringFormat}"
                                ContentSource="Header"
                                Margin="{av:TemplateBinding av:Control.Padding}"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center" />
                        </av:Border>
                        <av:ControlTemplate.Triggers>
                            <av:Trigger
                                Property="av:UIElement.IsMouseOver">
                                <av:Setter
                                    Property="av:TextElement.Foreground">
                                    <av:Setter.Value>
                                        <av:DynamicResource
                                            ResourceKey="TextPrimary" />
                                    </av:Setter.Value>
                                </av:Setter>
                                <av:Setter
                                    Property="av:Panel.Background">
                                    <av:Setter.Value>
                                        <av:DynamicResource
                                            ResourceKey="SidebarBackground" />
                                    </av:Setter.Value>
                                </av:Setter>
                                <av:Trigger.Value>
                                    <s:Boolean>True</s:Boolean>
                                </av:Trigger.Value>
                            </av:Trigger>
                            <av:Trigger
                                Property="av:Selector.IsSelected">
                                <av:Setter
                                    Property="av:TextElement.Foreground">
                                    <av:Setter.Value>
                                        <av:DynamicResource
                                            ResourceKey="AccentColor" />
                                    </av:Setter.Value>
                                </av:Setter>
                                <av:Setter
                                    Property="av:Border.BorderBrush"
                                    TargetName="border">
                                    <av:Setter.Value>
                                        <av:DynamicResource
                                            ResourceKey="AccentColor" />
                                    </av:Setter.Value>
                                </av:Setter>
                                <av:Setter
                                    Property="av:Panel.Background">
                                    <av:Setter.Value>
                                        <av:DynamicResource
                                            ResourceKey="PanelBackground" />
                                    </av:Setter.Value>
                                </av:Setter>
                                <av:Trigger.Value>
                                    <s:Boolean>True</s:Boolean>
                                </av:Trigger.Value>
                            </av:Trigger>
                        </av:ControlTemplate.Triggers>
                    </av:ControlTemplate>
                </av:Setter.Value>
            </av:Setter>
        </av:Style>
    </av:UserControl.Resources>
    <av:Grid
        Margin="15,15,15,15">
        <av:Grid.RowDefinitions>
            <av:RowDefinition
                Height="Auto" />
            <av:RowDefinition
                Height="*" />
            <av:RowDefinition
                Height="Auto" />
        </av:Grid.RowDefinitions>
