                                                    </av:Setter.Value>
                                                </av:Setter>
                                                <av:Trigger.Value>
                                                    <s:Boolean>True</s:Boolean>
                                                </av:Trigger.Value>
                                            </av:Trigger>
                                        </av:ControlTemplate.Triggers>
                                    </av:ControlTemplate>
                                </av:Setter.Value>
                            </av:Setter>
                        </av:Style>
                    </av:TabItem.Style>
                    <av:ScrollViewer
                        VerticalScrollBarVisibility="Auto"
                        HorizontalScrollBarVisibility="Disabled">
                        <av:Grid
                            Margin="15,15,15,15">
                            <av:StackPanel
                                MaxWidth="500"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Top">
                                <av:Label Name="LblTheme">Chủ đề hiển thị (Theme):</av:Label>
                                <av:ComboBox
                                    Name="CboTheme"
                                    Margin="0,0,0,15">
                                    <av:ComboBoxItem
                                        Tag="light">Light</av:ComboBoxItem>
                                    <av:ComboBoxItem
                                        Tag="dark">Dark</av:ComboBoxItem>
                                    <av:ComboBoxItem
                                        Tag="blue">Blue</av:ComboBoxItem>
                                </av:ComboBox>
                                <av:Label Name="LblFontSize">Cỡ chữ hệ thống (Font Size):</av:Label>
                                <av:Grid
                                    Margin="0,0,0,15">
                                    <av:Grid.ColumnDefinitions>
                                        <av:ColumnDefinition
                                            Width="*" />
                                        <av:ColumnDefinition
                                            Width="Auto" />
                                    </av:Grid.ColumnDefinitions>
                                    <av:Slider
                                        IsSnapToTickEnabled="True"
                                        TickFrequency="1"
                                        Minimum="10"
                                        Maximum="16"
                                        Name="SldFontSize"
                                        VerticalAlignment="Center" />
