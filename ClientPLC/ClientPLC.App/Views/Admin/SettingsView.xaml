                                Property="av:Panel.Background">
                                <av:Setter.Value>
                                    <av:DynamicResource
                                        ResourceKey="WindowBackground" />
                                </av:Setter.Value>
                            </av:Setter>
                            <av:Setter
                                Property="av:Control.Padding">
                                <av:Setter.Value>
                                    <av:Thickness>18,10,18,10</av:Thickness>
                                </av:Setter.Value>
                            </av:Setter>
                            <av:Setter
                                Property="av:TextElement.FontWeight">
                                <av:Setter.Value>
                                    <av:FontWeight>SemiBold</av:FontWeight>
                                </av:Setter.Value>
                            </av:Setter>
                            <av:Setter
                                Property="av:TextElement.FontSize">
                                <av:Setter.Value>
                                    <av:DynamicResource
                                        ResourceKey="BaseFontSize" />
                                </av:Setter.Value>
                            </av:Setter>
                            <av:Setter
                                Property="av:Control.Template">
                                <av:Setter.Value>
                                    <av:ControlTemplate
