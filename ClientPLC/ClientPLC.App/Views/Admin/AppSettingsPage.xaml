<UserControl x:Class="PLC.Views.AppSettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <Grid Margin="15">
        <Border BorderThickness="1" Padding="20" CornerRadius="8"
                BorderBrush="{DynamicResource BorderBrush}"
                Background="{DynamicResource PanelBackground}"
                MaxWidth="600" HorizontalAlignment="Left" VerticalAlignment="Top">
            <StackPanel>
                <TextBlock Text="Cài đặt ứng dụng" FontWeight="Bold" FontSize="16" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,20"/>

                <Label Content="Chủ đề hiển thị (Theme):" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,5"/>
                <ComboBox Name="CboTheme" Margin="0,0,0,15" Height="30">
                    <ComboBoxItem Content="Light" Tag="light"/>
                    <ComboBoxItem Content="Dark" Tag="dark"/>
                    <ComboBoxItem Content="Blue" Tag="blue"/>
                </ComboBox>

                <Label Content="Cỡ chữ hệ thống (Font Size):" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,5"/>
                <Grid Margin="0,0,0,15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Slider Name="SldFontSize" IsSnapToTickEnabled="True" TickFrequency="1" Minimum="10" Maximum="16" VerticalAlignment="Center"/>
                    <TextBlock Name="TxtFontSizeVal" Text="12 px" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" Margin="10,0,0,0" Grid.Column="1" VerticalAlignment="Center"/>
                </Grid>

                <Label Content="Ngôn ngữ giao diện:" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,5"/>
                <ComboBox Name="CboLanguage" Margin="0,0,0,15" Height="30">
                    <ComboBoxItem Content="Tiếng Việt" Tag="vi"/>
                    <ComboBoxItem Content="English" Tag="en"/>
                    <ComboBoxItem Content="中文 (Chinese)" Tag="zh"/>
                </ComboBox>

                <CheckBox Name="ChkUseMockData" Content="Sử dụng dữ liệu ảo (Demo Mode)" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,25" Height="25" VerticalContentAlignment="Center"/>

                <Button Name="BtnSave" Content="Lưu cấu hình" Height="35" Width="150" HorizontalAlignment="Left"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
