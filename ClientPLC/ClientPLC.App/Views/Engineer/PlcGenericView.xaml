                                                TargetType="av:Button">
                                                <av:Border
                                                    BorderThickness="{av:TemplateBinding av:Border.BorderThickness}"
                                                    CornerRadius="4,4,4,4"
                                                    BorderBrush="{av:TemplateBinding av:Border.BorderBrush}"
                                                    Background="{av:TemplateBinding av:Panel.Background}"
                                                    Name="border">
                                                    <av:ContentPresenter
                                                        Content="{av:TemplateBinding av:ContentControl.Content}"
                                                        ContentTemplate="{av:TemplateBinding av:ContentControl.ContentTemplate}"
                                                        ContentStringFormat="{av:TemplateBinding av:ContentControl.ContentStringFormat}"
                                                        Margin="{av:TemplateBinding av:Control.Padding}"
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center" />
                                                </av:Border>
                                                <av:ControlTemplate.Triggers>
                                                    <av:Trigger
                                                        Property="av:UIElement.IsMouseOver">
                                                        <av:Setter
                                                            Property="av:Panel.Background">
                                                            <av:Setter.Value>
                                                                <av:DynamicResource
                                                                    ResourceKey="SidebarBackground" />
                                                            </av:Setter.Value>
                                                        </av:Setter>
                                                        <av:Trigger.Value>
                                                            <s:Boolean>True</s:Boolean>
                                                        </av:Trigger.Value>
                                                    </av:Trigger>
                                                    <av:Trigger
                                                        Property="av:UIElement.IsEnabled">
                                                        <av:Setter
                                                            Property="av:UIElement.Opacity">
                                                            <av:Setter.Value>
                                                                <s:Double>0.5</s:Double>
                                                            </av:Setter.Value>
                                                        </av:Setter>
                                                        <av:Trigger.Value>
                                                            <s:Boolean>False</s:Boolean>
                                                        </av:Trigger.Value>
                                                    </av:Trigger>
                                                </av:ControlTemplate.Triggers>
                                            </av:ControlTemplate>
                                        </av:Setter.Value>
                                    </av:Setter>
                                </av:Style>
                            </av:Button.Style>
                            <av:StackPanel Orientation="Horizontal">
                                <av:Path Data="{av:StaticResource IconFilePlus}" Stroke="{av:Binding Foreground, RelativeSource={av:RelativeSource AncestorType=av:Button}}" StrokeThickness="1.8" Width="14" Height="14" Margin="0,0,7,0" VerticalAlignment="Center" Stretch="Uniform"/>
                                <av:TextBlock Name="TxtBtnWrite" Text="GHI DỮ LIỆU" VerticalAlignment="Center"/>
                            </av:StackPanel>
                        </av:Button>
                    </av:StackPanel>
                </av:Grid>
            </av:Border>
            <av:Border
                BorderThickness="1,1,1,1"
                Padding="15,15,15,15"
                CornerRadius="4,4,4,4"
                BorderBrush="{av:DynamicResource BorderBrush}"
                Background="{av:DynamicResource PanelBackground}"
                av:Grid.Column="1">
                <av:Grid>
                    <av:Grid.RowDefinitions>
                        <av:RowDefinition
                            Height="Auto" />
