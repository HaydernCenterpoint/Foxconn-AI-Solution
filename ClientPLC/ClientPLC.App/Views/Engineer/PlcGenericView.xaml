                            Text="Int16"
                            Name="CboDataType"
                            Margin="0,0,0,12">
                            <av:ComboBoxItem>Bool</av:ComboBoxItem>
                            <av:ComboBoxItem
                                IsSelected="True">Int16</av:ComboBoxItem>
                            <av:ComboBoxItem>UInt16</av:ComboBoxItem>
                            <av:ComboBoxItem>Int32</av:ComboBoxItem>
                            <av:ComboBoxItem>UInt32</av:ComboBoxItem>
                            <av:ComboBoxItem>Float</av:ComboBoxItem>
                            <av:ComboBoxItem>Double</av:ComboBoxItem>
                            <av:ComboBoxItem>String</av:ComboBoxItem>
                        </av:ComboBox>
                        <av:Label Name="LblWriteValue">Giá trị cần ghi (nếu có):</av:Label>
                        <av:TextBox
                            Name="TxtWriteValue"
                            Margin="0,0,0,15"
                            xml:space="preserve" />
                    </av:StackPanel>
                    <av:StackPanel
                        av:Grid.Row="1">
                        <av:Button
                            Name="BtnRead"
                            Height="36"
                            Margin="0,0,0,10"
                            IsEnabled="False">
                            <av:Button.Style>
                                <av:Style
                                    TargetType="av:Button">
                                    <av:Style.BasedOn>
                                        <av:Style
                                            TargetType="av:Button">
                                            <av:Style.Resources>
                                                <av:ResourceDictionary />
                                            </av:Style.Resources>
                                            <av:Setter
                                                Property="av:TextElement.FontFamily">
                                                <av:Setter.Value>
                                                    <av:FontFamily>Segoe UI, Inter, Roboto, Arial</av:FontFamily>
                                                </av:Setter.Value>
                                            </av:Setter>
                                            <av:Setter
                                                Property="av:TextElement.FontSize">
                                                <av:Setter.Value>
                                                    <av:DynamicResource
                                                        ResourceKey="BaseFontSize" />
                                                </av:Setter.Value>
                                            </av:Setter>
                                            <av:Setter
                                                Property="av:Panel.Background">
                                                <av:Setter.Value>
                                                    <av:DynamicResource
                                                        ResourceKey="PanelBackground" />
                                                </av:Setter.Value>
                                            </av:Setter>
                                            <av:Setter
                                                Property="av:TextElement.Foreground">
                                                <av:Setter.Value>
                                                    <av:DynamicResource
                                                        ResourceKey="TextPrimary" />
                                                </av:Setter.Value>
                                            </av:Setter>
                                            <av:Setter
                                                Property="av:Border.BorderBrush">
                                                <av:Setter.Value>
                                                    <av:DynamicResource
                                                        ResourceKey="BorderBrush" />
                                                </av:Setter.Value>
                                            </av:Setter>
                                            <av:Setter
                                                Property="av:Border.BorderThickness">
                                                <av:Setter.Value>
                                                    <av:Thickness>1,1,1,1</av:Thickness>
                                                </av:Setter.Value>
                                            </av:Setter>
                                            <av:Setter
                                                Property="av:FrameworkElement.Height">
                                                <av:Setter.Value>
                                                    <s:Double>32</s:Double>
                                                </av:Setter.Value>
                                            </av:Setter>
                                            <av:Setter
                                                Property="av:Control.Padding">
                                                <av:Setter.Value>
                                                    <av:Thickness>15,0,15,0</av:Thickness>
                                                </av:Setter.Value>
                                            </av:Setter>
                                            <av:Setter
                                                Property="av:FrameworkElement.Cursor">
                                                <av:Setter.Value>
                                                    <av:Cursor>Hand</av:Cursor>
                                                </av:Setter.Value>
                                            </av:Setter>
                                            <av:Setter
                                                Property="av:Control.Template">
                                                <av:Setter.Value>
                                                    <av:ControlTemplate
                                                        TargetType="av:Button">
                                                        <av:Border
                                                            BorderThickness="{av:TemplateBinding av:Border.BorderThickness}"
                                                            CornerRadius="4,4,4,4"
                                                            BorderBrush="{av:TemplateBinding av:Border.BorderBrush}"
                                                            Background="{av:TemplateBinding av:Panel.Background}"
                                                            Name="border">
                                                            <av:ContentPresenter
                                                                Content="{av:TemplateBinding av:ContentControl.Content}"
                                                                ContentTemplate="{av:TemplateBinding av:ContentControl.ContentTemplate}"
                                                                ContentStringFormat="{av:TemplateBinding av:ContentControl.ContentStringFormat}"
                                                                Margin="{av:TemplateBinding av:Control.Padding}"
                                                                HorizontalAlignment="Center"
                                                                VerticalAlignment="Center" />
                                                        </av:Border>
                                                        <av:ControlTemplate.Triggers>
                                                            <av:Trigger
                                                                Property="av:UIElement.IsMouseOver">
                                                                <av:Setter
                                                                    Property="av:Panel.Background">
                                                                    <av:Setter.Value>
                                                                        <av:DynamicResource
                                                                            ResourceKey="SidebarBackground" />
                                                                    </av:Setter.Value>
                                                                </av:Setter>
                                                                <av:Trigger.Value>
                                                                    <s:Boolean>True</s:Boolean>
                                                                </av:Trigger.Value>
                                                            </av:Trigger>
                                                            <av:Trigger
                                                                Property="av:UIElement.IsEnabled">
                                                                <av:Setter
                                                                    Property="av:UIElement.Opacity">
                                                                    <av:Setter.Value>
                                                                        <s:Double>0.5</s:Double>
                                                                    </av:Setter.Value>
                                                                </av:Setter>
                                                                <av:Trigger.Value>
                                                                    <s:Boolean>False</s:Boolean>
                                                                </av:Trigger.Value>
                                                            </av:Trigger>
                                                        </av:ControlTemplate.Triggers>
                                                    </av:ControlTemplate>
                                                </av:Setter.Value>
                                            </av:Setter>
                                        </av:Style>
                                    </av:Style.BasedOn>
                                    <av:Style.Resources>
                                        <av:ResourceDictionary />
                                    </av:Style.Resources>
                                    <av:Setter
                                        Property="av:Panel.Background">
                                        <av:Setter.Value>
                                            <av:DynamicResource
                                                ResourceKey="AccentColor" />
                                        </av:Setter.Value>
                                    </av:Setter>
                                    <av:Setter
                                        Property="av:TextElement.Foreground">
                                        <av:Setter.Value>
                                            <av:SolidColorBrush>#FFFFFFFF</av:SolidColorBrush>
                                        </av:Setter.Value>
                                    </av:Setter>
                                    <av:Setter
                                        Property="av:Border.BorderThickness">
                                        <av:Setter.Value>
                                            <av:Thickness>0,0,0,0</av:Thickness>
                                        </av:Setter.Value>
                                    </av:Setter>
                                    <av:Setter
                                        Property="av:TextElement.FontWeight">
                                        <av:Setter.Value>
                                            <av:FontWeight>SemiBold</av:FontWeight>
                                        </av:Setter.Value>
                                    </av:Setter>
                                    <av:Setter
                                        Property="av:Control.Template">
                                        <av:Setter.Value>
                                            <av:ControlTemplate
                                                TargetType="av:Button">
                                                <av:Border
                                                    CornerRadius="4,4,4,4"
                                                    Background="{av:TemplateBinding av:Panel.Background}"
                                                    Name="border">
                                                    <av:ContentPresenter
                                                        Content="{av:TemplateBinding av:ContentControl.Content}"
                                                        ContentTemplate="{av:TemplateBinding av:ContentControl.ContentTemplate}"
                                                        ContentStringFormat="{av:TemplateBinding av:ContentControl.ContentStringFormat}"
                                                        Margin="{av:TemplateBinding av:Control.Padding}"
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center" />
                                                </av:Border>
                                                <av:ControlTemplate.Triggers>
                                                    <av:Trigger
                                                        Property="av:UIElement.IsMouseOver">
                                                        <av:Setter
                                                            Property="av:Panel.Background">
                                                            <av:Setter.Value>
                                                                <av:DynamicResource
                                                                    ResourceKey="AccentHover" />
                                                            </av:Setter.Value>
                                                        </av:Setter>
                                                        <av:Trigger.Value>
                                                            <s:Boolean>True</s:Boolean>
                                                        </av:Trigger.Value>
                                                    </av:Trigger>
                                                    <av:Trigger
                                                        Property="av:UIElement.IsEnabled">
                                                        <av:Setter
                                                            Property="av:UIElement.Opacity">
                                                            <av:Setter.Value>
                                                                <s:Double>0.5</s:Double>
                                                            </av:Setter.Value>
                                                        </av:Setter>
                                                        <av:Trigger.Value>
                                                            <s:Boolean>False</s:Boolean>
                                                        </av:Trigger.Value>
                                                    </av:Trigger>
                                                </av:ControlTemplate.Triggers>
                                            </av:ControlTemplate>
                                        </av:Setter.Value>
                                    </av:Setter>
                                </av:Style>
                            </av:Button.Style>
                            <av:StackPanel Orientation="Horizontal">
                                <av:Path Data="{av:StaticResource IconFileText}" Stroke="{av:Binding Foreground, RelativeSource={av:RelativeSource AncestorType=av:Button}}" StrokeThickness="1.8" Width="14" Height="14" Margin="0,0,7,0" VerticalAlignment="Center" Stretch="Uniform"/>
                                <av:TextBlock Name="TxtBtnRead" Text="ĐỌC DỮ LIỆU" VerticalAlignment="Center"/>
                            </av:StackPanel>
                        </av:Button>
                        <av:Button
                            Name="BtnWrite"
                            Height="36"
                            IsEnabled="False">
                            <av:Button.Style>
                                <av:Style
                                    TargetType="av:Button">
                                    <av:Style.Resources>
                                        <av:ResourceDictionary />
                                    </av:Style.Resources>
                                    <av:Setter
                                        Property="av:TextElement.FontFamily">
                                        <av:Setter.Value>
                                            <av:FontFamily>Segoe UI, Inter, Roboto, Arial</av:FontFamily>
                                        </av:Setter.Value>
                                    </av:Setter>
                                    <av:Setter
                                        Property="av:TextElement.FontSize">
                                        <av:Setter.Value>
                                            <av:DynamicResource
                                                ResourceKey="BaseFontSize" />
                                        </av:Setter.Value>
                                    </av:Setter>
                                    <av:Setter
                                        Property="av:Panel.Background">
                                        <av:Setter.Value>
                                            <av:DynamicResource
                                                ResourceKey="PanelBackground" />
                                        </av:Setter.Value>
                                    </av:Setter>
                                    <av:Setter
                                        Property="av:TextElement.Foreground">
                                        <av:Setter.Value>
                                            <av:DynamicResource
                                                ResourceKey="TextPrimary" />
                                        </av:Setter.Value>
                                    </av:Setter>
