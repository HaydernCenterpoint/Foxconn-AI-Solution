<Window x:Class="PLC.Views.ExcelImportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Nhập Cấu Hình Từ Excel" 
        Height="620" Width="980" 
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackground}">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Top File Info and Selection -->
        <Border Grid.Row="0" BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}" Background="{DynamicResource PanelBackground}" CornerRadius="4" Padding="15" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Path Data="{StaticResource IconFolderOpen}" Stroke="#2563EB" StrokeThickness="2" Width="20" Height="20" Margin="0,0,10,0" VerticalAlignment="Center" Stretch="Uniform"/>
                        <TextBlock Name="TxtHeaderTitle" Text="NHẬP CẤU HÌNH EXCEL" FontWeight="Bold" FontSize="16" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Name="TxtFilePath" Text="Chưa chọn file..." Margin="0,5,0,0" Foreground="{DynamicResource TextSecondary}"/>
                </StackPanel>
                <Button Name="BtnBrowse" Grid.Column="1" Content="Chọn file Excel..." Width="130" Height="32" VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- Configuration & Mapping Settings -->
        <Border Grid.Row="1" BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}" Background="{DynamicResource PanelBackground}" CornerRadius="4" Padding="15" Margin="0,0,0,10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="200"/>
                    <ColumnDefinition Width="200"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Sheet & Header Row -->
                <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,15,10">
                    <Label Name="LblSelectSheet" Content="Chọn Sheet:" Foreground="{DynamicResource TextSecondary}" Padding="0,0,0,4"/>
                    <ComboBox Name="CboSheets" Height="28"/>
                </StackPanel>
                
                <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,15,10">
                    <Label Name="LblHeaderRow" Content="Dòng tiêu đề (0-indexed):" Foreground="{DynamicResource TextSecondary}" Padding="0,0,0,4"/>
                    <TextBox Name="TxtHeaderRow" Text="0" Height="28" Width="100" HorizontalAlignment="Left" Padding="5,2,5,2"/>
                </StackPanel>

                <StackPanel Grid.Row="0" Grid.Column="2" VerticalAlignment="Center" Margin="0,10,0,0">
                    <CheckBox Name="ChkHasHeader" Content="Dòng đầu tiên là tiêu đề" IsChecked="True" Foreground="{DynamicResource TextPrimary}"/>
                    <CheckBox Name="ChkSkipEmptyRows" Content="Bỏ qua dòng trống" IsChecked="True" Margin="0,5,0,0" Foreground="{DynamicResource TextPrimary}"/>
                </StackPanel>

                <!-- Mapping Mode -->
                <StackPanel Grid.Row="1" Grid.ColumnSpan="3" Orientation="Horizontal" Margin="0,5,0,0">
                    <RadioButton Name="RadTabularMode" Content="Dạng bảng chuẩn (Mỗi cột là 1 thuộc tính)" IsChecked="True" Foreground="{DynamicResource TextPrimary}" Margin="0,0,25,0" VerticalAlignment="Center"/>
                    <RadioButton Name="RadPairMode" Content="Dạng ghép cặp nhiều cột (Địa chỉ + Tên) - Giống baodong074_2" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Preview Area -->
        <Grid Grid.Row="2" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="320"/>
            </Grid.ColumnDefinitions>

            <!-- Table Preview Grid -->
            <Border Grid.Column="0" BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}" CornerRadius="4" Background="{DynamicResource PanelBackground}" Margin="0,0,10,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" Background="{DynamicResource SidebarBackground}" Padding="10,6,10,6" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource BorderBrush}">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Data="{StaticResource IconSearch}" Stroke="#526174" StrokeThickness="1.8" Width="16" Height="16" Margin="0,0,8,0" VerticalAlignment="Center" Stretch="Uniform"/>
                            <TextBlock Name="TxtPreviewHeader" Text="XEM TRƯỚC DỮ LIỆU EXCEL" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <DataGrid Name="DgPreview" Grid.Row="1" AutoGenerateColumns="True" Background="Transparent" BorderThickness="0" IsReadOnly="True" GridLinesVisibility="None"/>
                </Grid>
            </Border>

            <!-- Mapping Config Side panel -->
            <Border Grid.Column="1" BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}" CornerRadius="4" Background="{DynamicResource PanelBackground}" Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10" VerticalAlignment="Center">
                        <Path Data="{StaticResource IconCable}" Stroke="#2563EB" StrokeThickness="1.8" Width="16" Height="16" Margin="0,0,8,0" VerticalAlignment="Center" Stretch="Uniform"/>
                        <TextBlock Name="TxtMappingHeader" Text="ÁNH XẠ CỘT DỮ LIỆU" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>
                    </StackPanel>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <!-- Standard Tabular Mapping -->
                            <StackPanel Name="PnlTabularMapping">
                                <Label Name="LblMapAddress" Content="Cột Địa chỉ PLC (RegisterAddress)*:" Foreground="{DynamicResource TextSecondary}"/>
                                <ComboBox Name="CboMapAddress" Margin="0,0,0,8"/>

                                <Label Name="LblMapAlias" Content="Cột Tên gợi nhớ (AliasName)*:" Foreground="{DynamicResource TextSecondary}"/>
                                <ComboBox Name="CboMapAlias" Margin="0,0,0,8"/>

                                <Label Name="LblMapGroup" Content="Cột Nhóm (Group):" Foreground="{DynamicResource TextSecondary}"/>
                                <ComboBox Name="CboMapGroup" Margin="0,0,0,8"/>

                                <Label Name="LblMapType" Content="Cột Kiểu dữ liệu (DataType):" Foreground="{DynamicResource TextSecondary}"/>
                                <ComboBox Name="CboMapType" Margin="0,0,0,8"/>

                                <Label Name="LblMapActiveValue" Content="Cột Giá trị kích hoạt (ActiveValue):" Foreground="{DynamicResource TextSecondary}"/>
                                <ComboBox Name="CboMapActiveValue" Margin="0,0,0,8"/>

                                <Label Name="LblMapSeverity" Content="Cột Mức độ (Severity):" Foreground="{DynamicResource TextSecondary}"/>
                                <ComboBox Name="CboMapSeverity" Margin="0,0,0,8"/>

                                <Label Name="LblMapDescription" Content="Cột Mô tả lỗi (Description):" Foreground="{DynamicResource TextSecondary}"/>
                                <ComboBox Name="CboMapDescription" Margin="0,0,0,8"/>

                                <Label Name="LblMapSolution" Content="Cột Cách xử lý (Solution):" Foreground="{DynamicResource TextSecondary}"/>
                                <ComboBox Name="CboMapSolution" Margin="0,0,0,8"/>
                            </StackPanel>

                            <!-- Multi-column pair mapping -->
                            <StackPanel Name="PnlPairMapping" Visibility="Collapsed">
                                <TextBlock Name="TxtPairMappingHelp" Text="Chọn các cặp cột (Địa chỉ + Tên) cần nhập:" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,8" TextWrapping="Wrap"/>
                                <StackPanel Name="PnlPairsContainer">
                                    <!-- Checkboxes will be dynamically added here, e.g. [ ] Cột 1 & 2, [ ] Cột 3 & 4 -->
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <!-- Import Summary Count -->
        <Border Grid.Row="3" BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}" Background="{DynamicResource SidebarBackground}" CornerRadius="4" Padding="12" Margin="0,0,0,15">
            <WrapPanel Orientation="Horizontal">
                <TextBlock Name="TxtSummaryRows" Text="Tổng số dòng: 0" Margin="0,0,25,0" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/>
                <TextBlock Name="TxtSummaryValid" Text="Hợp lệ: 0" Margin="0,0,25,0" Foreground="#FF10B981" FontWeight="SemiBold"/>
                <TextBlock Name="TxtSummaryInvalid" Text="Không hợp lệ: 0" Margin="0,0,25,0" Foreground="#FFEF4444" FontWeight="SemiBold"/>
                <TextBlock Name="TxtSummaryDuplicate" Text="Trùng lặp: 0" Foreground="#FFF59E0B" FontWeight="SemiBold"/>
            </WrapPanel>
        </Border>

        <!-- Buttons -->
        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" Grid.Column="0">
                <TextBlock Name="LblApplyMode" Text="Chế độ áp dụng vào máy:" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <ComboBox Name="CboApplyMode" Width="200" Height="28">
                    <ComboBoxItem Name="CboApplyModeItemMerge" Content="Thêm mới &amp; Ghi đè dòng trùng" IsSelected="True" Tag="Merge"/>
                    <ComboBoxItem Name="CboApplyModeItemReplace" Content="Thay thế toàn bộ cấu hình máy" Tag="Replace"/>
                </ComboBox>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Grid.Column="2">
                <Button Name="BtnCancel" Content="Hủy" Width="100" Height="32" Margin="0,0,10,0"/>
                <Button Name="BtnApply" Content="Áp Dụng Vào Máy" Width="150" Height="32"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
