<UserControl x:Class="PLC.Views.PlcReadCycleConfigPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <Grid Margin="15">
        <Border BorderThickness="1" Padding="20" CornerRadius="8"
                BorderBrush="{DynamicResource BorderBrush}"
                Background="{DynamicResource PanelBackground}"
                MaxWidth="600" HorizontalAlignment="Left" VerticalAlignment="Top">
            <StackPanel>
                <TextBlock Text="Chu kỳ đọc dữ liệu PLC" FontWeight="Bold" FontSize="16" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,20"/>

                <Label Content="Chu kỳ đọc dữ liệu liên tục (ms):" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,5"/>
                <TextBox Name="TxtInterval" Margin="0,0,0,25" Height="30" VerticalContentAlignment="Center"/>

                <Button Name="BtnSave" Content="Lưu cấu hình" Height="35" Width="150" HorizontalAlignment="Left"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
