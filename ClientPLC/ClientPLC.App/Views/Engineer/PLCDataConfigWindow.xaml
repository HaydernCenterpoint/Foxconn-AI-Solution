<Window x:Class="PLC.Views.PLCDataConfigWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cấu Hình Địa Chỉ PLC" 
        Height="700" Width="1080"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackground}">
    <Window.Resources>
        <!-- Reusable Premium Button Style -->
        <Style TargetType="Button" x:Key="PremiumBtnStyle">
            <Setter Property="TextElement.FontFamily" Value="Segoe UI, Inter, Roboto, Arial"/>
            <Setter Property="TextElement.FontSize" Value="{DynamicResource BaseFontSize}"/>
            <Setter Property="Background" Value="{DynamicResource PanelBackground}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="12,0,12,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                Background="{TemplateBinding Background}"
                                Name="border">
                            <ContentPresenter Content="{TemplateBinding Content}"
                                              Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource SidebarBackground}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Premium Red/Danger Button Style -->
        <Style TargetType="Button" x:Key="DangerBtnStyle" BasedOn="{StaticResource PremiumBtnStyle}">
            <Setter Property="Background" Value="#FFEF4444"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FFF87171"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Premium Cyan/Success/Accent Button Style -->
        <Style TargetType="Button" x:Key="SuccessBtnStyle" BasedOn="{StaticResource PremiumBtnStyle}">
            <Setter Property="Background" Value="{DynamicResource AccentColor}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource AccentHover}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Premium TabControl Style -->
        <Style TargetType="TabControl">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
        </Style>

        <!-- Premium TabItem Style -->
        <Style TargetType="TabItem">
            <Setter Property="FontFamily" Value="Segoe UI, Inter, Roboto, Arial"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="24,0,24,0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0,0,0,2"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border Name="Border" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                Background="{TemplateBinding Background}" 
                                SnapsToDevicePixels="True">
                            <ContentPresenter x:Name="ContentSite"
                                              ContentSource="Header"
                                              Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Border" Property="BorderBrush" Value="{DynamicResource AccentColor}"/>
                                <Setter Property="Foreground" Value="{DynamicResource AccentColor}"/>
                                <Setter Property="Background" Value="#1500d2fc"/> <!-- Subtle transparent accent color -->
                            </Trigger>
                            <Trigger Property="IsSelected" Value="False">
                                <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /> <!-- Menu Bar -->
            <RowDefinition Height="*" />    <!-- Main Content Area -->
        </Grid.RowDefinitions>

        <!-- Menu Bar inside Config Window -->
        <Menu Grid.Row="0" Background="{DynamicResource PanelBackground}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="5,2,5,2">
            <MenuItem x:Name="MnuFile" Header="_File" Foreground="{DynamicResource TextPrimary}">
                <MenuItem Name="MnuNew" Header="_New Config (_N)" InputGestureText="Ctrl+N"/>
                <MenuItem Name="MnuOpen" Header="_Open Config (_O)..." InputGestureText="Ctrl+O"/>
                <MenuItem Name="MnuSave" Header="_Save Config (_S)" InputGestureText="Ctrl+S"/>
                <MenuItem Name="MnuSaveAs" Header="Save Config _As (_A)..." InputGestureText="Ctrl+Shift+S"/>
                <Separator/>
                <MenuItem Name="MnuImportExcel" Header="Nhập từ Excel..."/>
                <MenuItem Name="MnuExportCsv" Header="Xuất Excel/CSV..."/>
                <Separator/>
                <MenuItem Name="MnuClose" Header="Đóng cửa sổ"/>
            </MenuItem>
        </Menu>

        <Grid Grid.Row="1" Margin="15">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Top Toolbar -->
            <Grid Margin="0,0,0,15" Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock
                        Text="Trạng thái cấu hình: Đang hoạt động"
                        FontWeight="SemiBold"
                        FontSize="{DynamicResource BaseFontSize}"
                        Foreground="#FF10B981"
                        Name="TxtStatus"
                        VerticalAlignment="Center" Margin="0,0,15,0" />
                </StackPanel>
                
                <StackPanel Orientation="Horizontal" Grid.Column="1" VerticalAlignment="Center">
                    <Button
                        Name="BtnTestRead"
                        Style="{StaticResource PremiumBtnStyle}"
                        Margin="0,0,5,0"
                        Height="32">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconActivity}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.8" Width="15" Height="15" Margin="0,0,7,0" VerticalAlignment="Center" Stretch="Uniform"/>
                            <TextBlock Text="Đọc thử" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button
                        Name="BtnRefresh"
                        Style="{StaticResource PremiumBtnStyle}"
                        Margin="0,0,5,0"
                        Height="32">Tải Lại Cấu Hình</Button>
                    <Button
                        Name="BtnApply"
                        Style="{StaticResource SuccessBtnStyle}"
                        Height="32" Width="110">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconActivity}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.8" Width="15" Height="15" Margin="0,0,7,0" VerticalAlignment="Center" Stretch="Uniform"/>
                            <TextBlock Text="Áp dụng" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- 4 Tab Control wrapped in a styled Border to unify styling with SettingsView -->
            <Border Grid.Row="1" BorderThickness="1" CornerRadius="4" BorderBrush="{DynamicResource BorderBrush}" Background="{DynamicResource PanelBackground}">
                <TabControl Background="Transparent" BorderThickness="0" Padding="0">
                    <!-- TAB 1: Trạng thái (3 fixed values: Start, Stop, Error) -->
                    <TabItem x:Name="TabItemStatus" Header="Trạng thái" Foreground="{DynamicResource TextPrimary}">
                        <Grid Margin="10">
                            <Grid.RowDefinitions>
                                <av:RowDefinition Height="Auto" xmlns:av="http://schemas.microsoft.com/winfx/2006/xaml/presentation"/>
                                <av:RowDefinition Height="*" xmlns:av="http://schemas.microsoft.com/winfx/2006/xaml/presentation"/>
                            </Grid.RowDefinitions>
                            <TextBlock x:Name="TxtStatusHelp" Text="[BẮT BUỘC] 3 địa chỉ trạng thái máy (Start/Stop/Error). Hệ thống dùng để xác định trạng thái dây chuyền trên dashboard." 
                                       Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,10" FontSize="13" FontStyle="Italic"/>
                            <DataGrid Grid.Row="1" Name="GridStatus" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" 
                                      GridLinesVisibility="None" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource TextPrimary}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn x:Name="ColStatusParam" Header="Tham số" Binding="{Binding Name}" IsReadOnly="True" Width="200"/>
                                    <DataGridTextColumn x:Name="ColStatusAddr" Header="Địa chỉ PLC" Binding="{Binding Address, UpdateSourceTrigger=PropertyChanged}" Width="250"/>
                                    <DataGridComboBoxColumn x:Name="ColStatusType" Header="Kiểu dữ liệu" SelectedItemBinding="{Binding Type, UpdateSourceTrigger=PropertyChanged}" Width="200"/>
                                    <DataGridTextColumn x:Name="ColStatusValue" Header="Giá trị hiện tại" Binding="{Binding Value}" IsReadOnly="True" Width="150"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </TabItem>

                    <!-- TAB 2: Sản phẩm (2 fixed values: Quantity, Cycle Time) -->
                    <TabItem x:Name="TabItemProducts" Header="Sản phẩm" Foreground="{DynamicResource TextPrimary}">
                        <Grid Margin="10">
                            <Grid.RowDefinitions>
                                <av:RowDefinition Height="Auto" xmlns:av="http://schemas.microsoft.com/winfx/2006/xaml/presentation"/>
                                <av:RowDefinition Height="*" xmlns:av="http://schemas.microsoft.com/winfx/2006/xaml/presentation"/>
                            </Grid.RowDefinitions>
                            <TextBlock x:Name="TxtProductsHelp" Text="[BẮT BUỘC] Địa chỉ sản lượng: Quantity (sản lượng tức thời) và Cycle Time (thời gian chu kỳ). Thiếu các địa chỉ này sẽ khiến biểu đồ OEE và sản lượng không hoạt động." 
                                       Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,10" FontSize="13" FontStyle="Italic"/>
                            <DataGrid Grid.Row="1" Name="GridProducts" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" 
                                      GridLinesVisibility="None" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource TextPrimary}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn x:Name="ColProductParam" Header="Tham số" Binding="{Binding Name}" IsReadOnly="True" Width="200"/>
                                    <DataGridTextColumn x:Name="ColProductAddr" Header="Địa chỉ PLC" Binding="{Binding Address, UpdateSourceTrigger=PropertyChanged}" Width="250"/>
                                    <DataGridComboBoxColumn x:Name="ColProductType" Header="Kiểu dữ liệu" SelectedItemBinding="{Binding Type, UpdateSourceTrigger=PropertyChanged}" Width="200"/>
                                    <DataGridTextColumn x:Name="ColProductValue" Header="Giá trị hiện tại" Binding="{Binding Value}" IsReadOnly="True" Width="150"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </TabItem>

                    <!-- TAB 2.5: Chất lượng (OK/NG) -->
                    <TabItem x:Name="TabItemQuality" Header="Chất lượng" Foreground="{DynamicResource TextPrimary}">
                        <Grid Margin="10">
                            <Grid.RowDefinitions>
                                <av:RowDefinition Height="Auto" xmlns:av="http://schemas.microsoft.com/winfx/2006/xaml/presentation"/>
                                <av:RowDefinition Height="*" xmlns:av="http://schemas.microsoft.com/winfx/2006/xaml/presentation"/>
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0" Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="TxtQualityHelp" Text="Danh sách các địa chỉ kiểm tra chất lượng (ví dụ: các lỗi NG chụp ảnh, quét mã lỗi...)" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondary}" FontSize="13" FontStyle="Italic"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <Button Name="BtnAddQuality" Style="{StaticResource PremiumBtnStyle}" Margin="0,0,5,0">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Data="{StaticResource IconFilePlus}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.8" Width="14" Height="14" Margin="0,0,6,0" VerticalAlignment="Center" Stretch="Uniform"/>
                                            <TextBlock Text="Thêm" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Name="BtnDeleteQuality" Style="{StaticResource DangerBtnStyle}" Margin="0,0,5,0">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Data="{StaticResource IconWinClose}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.8" Width="14" Height="14" Margin="0,0,6,0" VerticalAlignment="Center" Stretch="Uniform"/>
                                            <TextBlock Text="Xóa" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Name="BtnImportQuality" Style="{StaticResource PremiumBtnStyle}" Margin="0,0,5,0">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="Nhập CSV" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Name="BtnExportQuality" Style="{StaticResource PremiumBtnStyle}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="Xuất CSV" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Grid>
                            <DataGrid Grid.Row="1" Name="GridQuality" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" 
                                      GridLinesVisibility="None" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource TextPrimary}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn x:Name="ColQualityParam" Header="Tham số" Binding="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Width="200"/>
                                    <DataGridTextColumn x:Name="ColQualityAddr" Header="Địa chỉ PLC" Binding="{Binding Address, UpdateSourceTrigger=PropertyChanged}" Width="250"/>
                                    <DataGridComboBoxColumn x:Name="ColQualityType" Header="Kiểu dữ liệu" SelectedItemBinding="{Binding Type, UpdateSourceTrigger=PropertyChanged}" Width="200"/>
                                    <DataGridTextColumn x:Name="ColQualityValue" Header="Giá trị hiện tại" Binding="{Binding Value}" IsReadOnly="True" Width="150"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </TabItem>

                    <!-- TAB 3: Thông báo / Báo động (Can import, add, delete, export) -->
                    <TabItem x:Name="TabItemAlarms" Header="Thông báo" Foreground="{DynamicResource TextPrimary}">
                        <Grid Margin="10">
                            <Grid.RowDefinitions>
                                <av:RowDefinition Height="Auto" xmlns:av="http://schemas.microsoft.com/winfx/2006/xaml/presentation"/>
                                <av:RowDefinition Height="*" xmlns:av="http://schemas.microsoft.com/winfx/2006/xaml/presentation"/>
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0" Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="TxtAlarmsHelp" Text="Danh sách các địa chỉ báo động lỗi" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondary}" FontSize="13" FontStyle="Italic"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <Button Name="BtnAddAlarm" Style="{StaticResource PremiumBtnStyle}" Margin="0,0,5,0">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Data="{StaticResource IconFilePlus}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.8" Width="14" Height="14" Margin="0,0,6,0" VerticalAlignment="Center" Stretch="Uniform"/>
                                            <TextBlock Text="Thêm" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Name="BtnDeleteAlarm" Style="{StaticResource DangerBtnStyle}" Margin="0,0,5,0">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Data="{StaticResource IconWinClose}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.8" Width="14" Height="14" Margin="0,0,6,0" VerticalAlignment="Center" Stretch="Uniform"/>
                                            <TextBlock Text="Xóa" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                     <Button Name="BtnImportAlarm" Style="{StaticResource PremiumBtnStyle}" Margin="0,0,5,0">
                                         <StackPanel Orientation="Horizontal">
                                             <Path Data="{StaticResource IconFilePlus}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.8" Width="14" Height="14" Margin="0,0,6,0" VerticalAlignment="Center" Stretch="Uniform"/>
                                             <TextBlock Text="Nhập CSV/Excel" VerticalAlignment="Center"/>
                                         </StackPanel>
                                     </Button>
                                    <Button Name="BtnExportAlarm" Style="{StaticResource PremiumBtnStyle}" Margin="0,0,5,0">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Data="{StaticResource IconLogOut}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.8" Width="14" Height="14" Margin="0,0,6,0" VerticalAlignment="Center" Stretch="Uniform"/>
                                            <TextBlock Text="Xuất CSV" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Name="BtnDownloadAlarmTemplate" Style="{StaticResource PremiumBtnStyle}">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Data="{StaticResource IconFileText}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.8" Width="14" Height="14" Margin="0,0,6,0" VerticalAlignment="Center" Stretch="Uniform"/>
                                            <TextBlock Text="Tải mẫu Excel" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Grid>
                            <DataGrid Grid.Row="1" Name="GridAlarms" AutoGenerateColumns="False" CanUserAddRows="False" 
                                      GridLinesVisibility="None" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource TextPrimary}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn x:Name="ColAlarmAddr" Header="Địa chỉ PLC" Binding="{Binding Address, UpdateSourceTrigger=PropertyChanged}" Width="150"/>
                                    <DataGridComboBoxColumn x:Name="ColAlarmType" Header="Kiểu dữ liệu" SelectedItemBinding="{Binding Type, UpdateSourceTrigger=PropertyChanged}" Width="120"/>
                                    <DataGridTextColumn x:Name="ColAlarmName" Header="Tên báo động (Error Name)" Binding="{Binding ErrorName, UpdateSourceTrigger=PropertyChanged}" Width="300"/>
                                    <DataGridTextColumn x:Name="ColAlarmValue" Header="Giá trị hiện tại" Binding="{Binding Value}" IsReadOnly="True" Width="120"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </TabItem>


                </TabControl>
            </Border>
        </Grid>
    </Grid>
</Window>
