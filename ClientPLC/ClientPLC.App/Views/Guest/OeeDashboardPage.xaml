<UserControl x:Class="PLC.Views.OeeDashboardPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">

    <UserControl.Resources>
        <!-- Geometries -->
        <Geometry x:Key="IconTrendUp">M 0,6 L 4,2 L 8,6</Geometry>
        <Geometry x:Key="IconTrendDown">M 0,2 L 4,6 L 8,2</Geometry>

        <!-- ── Dark DatePickerTextBox (removes white selection box) ── -->
        <Style TargetType="DatePickerTextBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{DynamicResource InputForeground}"/>
            <Setter Property="SelectionBrush" Value="{DynamicResource AccentColor}"/>
            <Setter Property="SelectionTextBrush" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="CaretBrush" Value="{DynamicResource TextSecondary}"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DatePickerTextBox">
                        <Border Background="Transparent" BorderThickness="0" Padding="0">
                            <Grid>
                                <ContentControl x:Name="PART_Watermark"
                                              Background="Transparent" Foreground="#64748B"
                                              VerticalContentAlignment="Center"
                                              HorizontalContentAlignment="Left"
                                              Focusable="False" IsHitTestVisible="False"
                                              Visibility="Collapsed"/>
                                <ScrollViewer x:Name="PART_ContentHost"
                                            Focusable="False"
                                            HorizontalScrollBarVisibility="Hidden"
                                            VerticalScrollBarVisibility="Hidden"
                                            VerticalAlignment="Center"
                                            Background="Transparent"/>
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── Dark CalendarDayButton ── -->
        <Style TargetType="CalendarDayButton">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Margin" Value="1"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CalendarDayButton">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="3" BorderThickness="1" BorderBrush="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SidebarBackground}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentColor}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentColor}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentColor}"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsToday" Value="True"/>
                                    <Condition Property="IsSelected" Value="False"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SidebarMenuHeaderBackground}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentColor}"/>
                                <Setter Property="Foreground" Value="{DynamicResource AccentColor}"/>
                            </MultiTrigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#475569"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── Dark CalendarButton ── -->
        <Style TargetType="CalendarButton">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CalendarButton">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="3" BorderThickness="1" BorderBrush="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SidebarBackground}"/>
                            </Trigger>
                            <Trigger Property="HasSelectedDays" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentColor}"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── Dark CalendarItem (fixes white header box) ── -->
        <Style TargetType="CalendarItem">
            <Setter Property="Margin" Value="0"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="Background" Value="{DynamicResource PanelBackground}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CalendarItem">
                        <ControlTemplate.Resources>
                            <Style TargetType="CalendarDayButton" BasedOn="{StaticResource {x:Type CalendarDayButton}}"/>
                            <DataTemplate x:Key="{x:Static CalendarItem.DayTitleTemplate}">
                                <TextBlock Text="{Binding}" FontSize="10" FontWeight="SemiBold"
                                           Foreground="#7183A8" HorizontalAlignment="Center"
                                           VerticalAlignment="Center" Margin="0,4,0,4"/>
                            </DataTemplate>
                        </ControlTemplate.Resources>
                        <Border Background="{DynamicResource PanelBackground}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0" CornerRadius="4">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <!-- Header -->
                                <Grid Grid.Row="0" Background="{DynamicResource SidebarMenuHeaderBackground}" Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Button x:Name="PART_PreviousButton" Grid.Column="0" Width="28" Height="28" Focusable="False" Background="Transparent" BorderThickness="0">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="Bd" Background="Transparent" CornerRadius="4" Padding="4">
                                                    <Path Data="M 8,4 L 4,8 L 8,12" Stroke="#B7C8E8" StrokeThickness="1.8" Width="8" Height="12" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="{DynamicResource SidebarBackground}"/></Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                    <Button x:Name="PART_HeaderButton" Grid.Column="1" Foreground="{DynamicResource TextPrimary}" FontSize="12" FontWeight="SemiBold" Background="Transparent" BorderThickness="0" HorizontalAlignment="Center">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="Bd" Background="Transparent" CornerRadius="4" Padding="6,2">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="{DynamicResource SidebarBackground}"/></Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                    <Button x:Name="PART_NextButton" Grid.Column="2" Width="28" Height="28" Focusable="False" Background="Transparent" BorderThickness="0">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="Bd" Background="Transparent" CornerRadius="4" Padding="4">
                                                    <Path Data="M 4,4 L 8,8 L 4,12" Stroke="#B7C8E8" StrokeThickness="1.8" Width="8" Height="12" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="{DynamicResource SidebarBackground}"/></Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </Grid>
                                <Grid x:Name="PART_MonthView" Grid.Row="1" Visibility="Visible" Margin="4,0,4,4"/>
                                <Grid x:Name="PART_YearView"  Grid.Row="1" Visibility="Hidden"  Margin="4,0,4,4"/>
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── Dark Calendar ── -->
        <Style TargetType="Calendar">
            <Setter Property="Background" Value="{DynamicResource PanelBackground}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <!-- ── Dark DatePicker style ── -->
        <Style x:Key="DarkDatePickerStyle" TargetType="DatePicker">
            <Setter Property="Background" Value="{DynamicResource InputBackground}"/>
            <Setter Property="Foreground" Value="{DynamicResource InputForeground}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource InputBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DatePicker">
                        <Grid x:Name="DatePickerRoot">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border x:Name="Border" Grid.ColumnSpan="2" CornerRadius="4"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"/>
                            <DatePickerTextBox x:Name="PART_TextBox" Grid.Column="0"
                                             Focusable="{TemplateBinding Focusable}"
                                             Background="Transparent"
                                             Foreground="{TemplateBinding Foreground}"
                                             BorderThickness="0" Padding="6,1,6,1"
                                             VerticalContentAlignment="Center"/>
                            <Button x:Name="PART_Button" Grid.Column="1"
                                    Width="26" Height="26" Margin="0,0,2,0"
                                    Focusable="False" Background="Transparent" BorderThickness="0">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="BtnBd" Background="Transparent" CornerRadius="3">
                                            <Path Data="M3,5 H17 V17 H3 Z M3,8 H17 M6,3 V5 M14,3 V5"
                                                  Stroke="{DynamicResource TextSecondary}" StrokeThickness="1.5"
                                                  Width="12" Height="12" Stretch="Uniform"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="BtnBd" Property="Background" Value="{DynamicResource SidebarBackground}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                            <Popup x:Name="PART_Popup" AllowsTransparency="True"
                                   Placement="Bottom" PlacementTarget="{Binding ElementName=Border}" StaysOpen="False">
                                <Border Background="{DynamicResource PanelBackground}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                        CornerRadius="4" Padding="4" Margin="0,2,0,0">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="10" ShadowDepth="2" Color="#000000" Opacity="0.3"/>
                                    </Border.Effect>
                                    <Calendar x:Name="PART_Calendar" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource TextPrimary}"/>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="BorderBrush" Value="#2F7BFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="14,10,14,10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- Row 0: Query Bar -->
            <RowDefinition Height="Auto"/>  <!-- Row 1: KPI Cards -->
            <RowDefinition Height="*"/>     <!-- Row 2: Charts Top -->
            <RowDefinition Height="*"/>     <!-- Row 3: Charts Bottom -->
        </Grid.RowDefinitions>

        <!-- ========== ROW 0: Query Bar ========== -->
        <Border Grid.Row="0" BorderThickness="1" CornerRadius="8" BorderBrush="{DynamicResource BorderBrush}"
                Background="{DynamicResource PanelBackground}" Padding="14,8,14,8" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Date -->
                <TextBlock Name="TxtQueryDate" Grid.Column="0" Text="Date" Foreground="{DynamicResource TextSecondary}" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <DatePicker Name="DpDate" Grid.Column="1" Width="120" Height="28" Margin="0,0,20,0"
                            Style="{StaticResource DarkDatePickerStyle}"/>

                <!-- Shift -->
                <TextBlock Name="TxtQueryShift" Grid.Column="2" Text="Shift" Foreground="{DynamicResource TextSecondary}" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <ComboBox Name="CboShift" Grid.Column="3" Width="185" Height="28" Margin="0,0,20,0"
                          Background="{DynamicResource InputBackground}" BorderBrush="{DynamicResource InputBorder}" Foreground="{DynamicResource InputForeground}" FontSize="12">
                    <ComboBoxItem Name="CboItemAll" Tag="All" IsSelected="True">Tất cả ca</ComboBoxItem>
                    <ComboBoxItem Name="CboItemDay" Tag="Day">Ca sáng (07:30 - 18:30)</ComboBoxItem>
                    <ComboBoxItem Name="CboItemNight" Tag="Night">Ca tối (19:30 - 06:30)</ComboBoxItem>
                </ComboBox>

                <!-- Production Line -->
                <TextBlock Name="TxtQueryProdLine" Grid.Column="4" Text="Production Line" Foreground="{DynamicResource TextSecondary}" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0" Visibility="Collapsed"/>
                <ComboBox Name="CboProdLine" Grid.Column="5" Width="110" Height="28" Margin="0,0,20,0"
                          Background="{DynamicResource InputBackground}" BorderBrush="{DynamicResource InputBorder}" Foreground="{DynamicResource InputForeground}" FontSize="12" Visibility="Collapsed">
                    <ComboBoxItem IsSelected="True">Line 1</ComboBoxItem>
                    <ComboBoxItem>Line 2</ComboBoxItem>
                    <ComboBoxItem>Line 3</ComboBoxItem>
                </ComboBox>

                <!-- Spacer -->
                <Grid Grid.Column="7"/>

                <!-- Search Button -->
                <Button Name="BtnQuery" Grid.Column="8" Height="30" Padding="16,0,16,0"
                        Background="#2F7BFF" Foreground="#FFFFFF" BorderThickness="0" Cursor="Hand" FontSize="12" FontWeight="SemiBold">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="5"/>
                        </Style>
                    </Button.Resources>
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource IconSearch}" Stroke="#FFFFFF" StrokeThickness="1.5"
                              Width="13" Height="13" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Name="TxtSearchBtn" Text="Search" Foreground="#FFFFFF" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <!-- ========== ROW 1: KPI Cards ========== -->
        <Grid Grid.Row="1" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Input Qty -->
            <Border Grid.Column="0" BorderThickness="1" CornerRadius="8" BorderBrush="{DynamicResource BorderBrush}" Background="{DynamicResource PanelBackground}" Padding="12,10" Margin="0,0,6,0">
                <StackPanel>
                    <TextBlock Name="TxtCardInputQtyTitle" Text="Input Qty" Foreground="{DynamicResource TextSecondary}" FontSize="11" Margin="0,0,0,2"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Name="TxtInputQty" Text="1,200" Foreground="{DynamicResource TextPrimary}" FontSize="22" FontWeight="Bold"/>
                        <Path Grid.Column="1" Data="M12,4 L12,20 M8,8 L12,4 L16,8" Stroke="#4FC3F7" StrokeThickness="1.8" Width="16" Height="16" Stretch="Uniform" VerticalAlignment="Center"/>
                    </Grid>
                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                        <TextBlock Name="TxtInputTrendLabel" Text="vs Yesterday" Foreground="{DynamicResource TextMuted}" FontSize="10"/>
                        <TextBlock Name="TxtInputQtyTrend" Text=" +8.52%" Foreground="#10B981" FontSize="10" FontWeight="SemiBold" Margin="4,0,0,0"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Yield % -->
            <Border Grid.Column="1" BorderThickness="1" CornerRadius="8" BorderBrush="{DynamicResource BorderBrush}" Background="{DynamicResource PanelBackground}" Padding="12,10" Margin="6,0,6,0">
                <StackPanel>
                    <TextBlock Name="TxtCardYieldTitle" Text="Yield (%)" Foreground="{DynamicResource TextSecondary}" FontSize="11" Margin="0,0,0,2"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Name="TxtYield" Text="99.24%" Foreground="#10B981" FontSize="20" FontWeight="Bold"/>
                        <!-- Donut indicator -->
                        <Grid Grid.Column="1" Width="24" Height="24" VerticalAlignment="Center">
                            <Ellipse Stroke="{DynamicResource BorderBrush}" StrokeThickness="4" Width="22" Height="22"/>
                            <Ellipse Name="GaugeYield" Stroke="#10B981" StrokeThickness="4" Width="22" Height="22"
                                     StrokeDashArray="18 4" RenderTransformOrigin="0.5,0.5">
                                <Ellipse.RenderTransform><RotateTransform Angle="-90"/></Ellipse.RenderTransform>
                            </Ellipse>
                        </Grid>
                    </Grid>
                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                        <TextBlock Name="TxtYieldTrendLabel" Text="vs Yesterday" Foreground="{DynamicResource TextMuted}" FontSize="10"/>
                        <TextBlock Name="TxtYieldTrend" Text=" +0.78%" Foreground="#10B981" FontSize="10" FontWeight="SemiBold" Margin="4,0,0,0"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- UPH -->
            <Border Grid.Column="2" BorderThickness="1" CornerRadius="8" BorderBrush="{DynamicResource BorderBrush}" Background="{DynamicResource PanelBackground}" Padding="12,10" Margin="6,0,6,0">
                <StackPanel>
                    <TextBlock Name="TxtCardUphTitle" Text="UPH" Foreground="{DynamicResource TextSecondary}" FontSize="11" Margin="0,0,0,2"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Name="TxtUph" Text="148" Foreground="{DynamicResource TextPrimary}" FontSize="22" FontWeight="Bold"/>
                        <!-- Speedometer icon placeholder -->
                        <Grid Grid.Column="1" Width="24" Height="24" VerticalAlignment="Center">
                            <Ellipse Stroke="{DynamicResource BorderBrush}" StrokeThickness="4" Width="22" Height="22"/>
                            <Ellipse Name="GaugeUph" Stroke="#F59E0B" StrokeThickness="4" Width="22" Height="22"
                                     StrokeDashArray="14 8" RenderTransformOrigin="0.5,0.5">
                                <Ellipse.RenderTransform><RotateTransform Angle="-90"/></Ellipse.RenderTransform>
                            </Ellipse>
                        </Grid>
                    </Grid>
                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                        <TextBlock Name="TxtUphTrendLabel" Text="vs Yesterday" Foreground="{DynamicResource TextMuted}" FontSize="10"/>
                        <TextBlock Name="TxtUphTrend" Text=" +6.47%" Foreground="#10B981" FontSize="10" FontWeight="SemiBold" Margin="4,0,0,0"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- OEE -->
            <Border Grid.Column="3" BorderThickness="1" CornerRadius="8" BorderBrush="{DynamicResource BorderBrush}" Background="{DynamicResource PanelBackground}" Padding="12,10" Margin="6,0,0,0">
                <StackPanel>
                    <TextBlock Name="TxtCardOeeTitle" Text="OEE" Foreground="{DynamicResource TextSecondary}" FontSize="11" Margin="0,0,0,2"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Name="TxtOeeVal" Text="89.35%" Foreground="{DynamicResource AccentColor}" FontSize="20" FontWeight="Bold"/>
                        <Path Grid.Column="1" Data="{StaticResource IconSettings}" Stroke="{DynamicResource AccentColor}" StrokeThickness="1.2"
                              Width="18" Height="18" Stretch="Uniform" VerticalAlignment="Center"/>
                    </Grid>
                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                        <TextBlock Name="TxtOeeTrendLabel" Text="vs Yesterday" Foreground="{DynamicResource TextMuted}" FontSize="10"/>
                        <TextBlock Name="TxtOeeTrend" Text=" +3.21%" Foreground="#10B981" FontSize="10" FontWeight="SemiBold" Margin="4,0,0,0"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ========== ROW 2: Top Charts (Hourly Output + Yield Trend) ========== -->
        <Grid Grid.Row="2" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Hourly Output Bar Chart -->
            <Border Grid.Column="0" BorderThickness="1" CornerRadius="8" BorderBrush="{DynamicResource BorderBrush}" Background="{DynamicResource PanelBackground}" Padding="14,10,14,10" Margin="0,0,6,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Title row -->
                    <Grid Grid.Row="0" Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Name="TxtHourlyOutputTitle" Text="Hourly Output" Foreground="{DynamicResource TextPrimary}" FontWeight="Bold" FontSize="13" VerticalAlignment="Center"/>
                        <!-- Legend -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Rectangle Width="10" Height="10" Fill="#2F7BFF" RadiusX="2" RadiusY="2" Margin="0,0,4,0" VerticalAlignment="Center"/>
                            <TextBlock Name="TxtHourlyOutputLegend" Text="Output (pcs)" Foreground="{DynamicResource TextSecondary}" FontSize="10" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                    <Canvas Name="ChartCanvas" Grid.Row="1" Background="Transparent" SizeChanged="ChartCanvas_SizeChanged"/>

                    <!-- X-axis labels -->
                    <Grid Grid.Row="2" Name="GridHourlyXAxis" Margin="30,4,8,0" />
                </Grid>
            </Border>

            <!-- Yield Trend Line Chart -->
            <Border Grid.Column="1" BorderThickness="1" CornerRadius="8" BorderBrush="{DynamicResource BorderBrush}" Background="{DynamicResource PanelBackground}" Padding="14,10,14,10" Margin="6,0,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Name="TxtYieldTrendTitle" Text="Yield Trend" Foreground="{DynamicResource TextPrimary}" FontWeight="Bold" FontSize="13" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Line X1="0" Y1="5" X2="16" Y2="5" Stroke="#2F7BFF" StrokeThickness="2" VerticalAlignment="Center" Margin="0,0,4,0"/>
                            <TextBlock Name="TxtYieldTrendLegend" Text="Yield (%)" Foreground="{DynamicResource TextSecondary}" FontSize="10" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                    <Canvas Name="YieldCanvas" Grid.Row="1" Background="Transparent" SizeChanged="YieldCanvas_SizeChanged"/>
                    <Grid Grid.Row="2" Name="GridYieldXAxis" Margin="30,4,8,0" />
                </Grid>
            </Border>
        </Grid>

        <!-- ========== ROW 3: Bottom Charts (CT Trend + Station Comparison) ========== -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- CT Trend Line Chart -->
            <Border Grid.Column="0" BorderThickness="1" CornerRadius="8" BorderBrush="{DynamicResource BorderBrush}" Background="{DynamicResource PanelBackground}" Padding="14,10,14,10" Margin="0,0,6,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Name="TxtCtTrendTitle" Text="CT Trend" Foreground="{DynamicResource TextPrimary}" FontWeight="Bold" FontSize="13" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Line X1="0" Y1="5" X2="16" Y2="5" Stroke="#2F7BFF" StrokeThickness="2" VerticalAlignment="Center" Margin="0,0,4,0"/>
                            <TextBlock Name="TxtCtTrendLegend" Text="CT (s)" Foreground="{DynamicResource TextSecondary}" FontSize="10" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                    <Canvas Name="CtCanvas" Grid.Row="1" Background="Transparent" SizeChanged="CtCanvas_SizeChanged"/>
                    <Grid Grid.Row="2" Name="GridCtXAxis" Margin="30,4,8,0" />
                </Grid>
            </Border>

            <!-- OEE Circular Chart -->
            <Border Grid.Column="1" BorderThickness="1" CornerRadius="8" BorderBrush="{DynamicResource BorderBrush}" Background="{DynamicResource PanelBackground}" Padding="14,10,14,10" Margin="6,0,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Name="TxtOeeAnalysisTitle" Text="OEE Analysis" Foreground="{DynamicResource TextPrimary}" FontWeight="Bold" FontSize="13" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Rectangle Width="10" Height="10" Fill="#2F7BFF" RadiusX="2" RadiusY="2" Margin="0,0,4,0" VerticalAlignment="Center"/>
                            <TextBlock Name="TxtOeeAnalysisLegend" Text="OEE (%)" Foreground="{DynamicResource TextSecondary}" FontSize="10" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                    
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.2*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        
                        <!-- Left: Circular Gauge -->
                        <Canvas Name="OeeCanvas" Grid.Column="0" Background="Transparent" SizeChanged="OeeCanvas_SizeChanged"/>
                        
                        <!-- Right: OEE Factors -->
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="30,0,25,0">
                            <!-- Availability -->
                            <StackPanel Margin="0,0,0,18">
                                <Grid Margin="0,0,0,6">
                                    <TextBlock Name="TxtAvailabilityFactor" Text="Availability (Khả dụng)" Foreground="{DynamicResource TextSecondary}" FontSize="11.5" FontWeight="SemiBold"/>
                                    <TextBlock Name="TxtOeeAvailVal" Text="92.50%" Foreground="#FFB020" FontSize="12.5" FontWeight="Bold" HorizontalAlignment="Right"/>
                                </Grid>
                                <Grid Height="8">
                                    <Border Background="{DynamicResource WindowBackground}" CornerRadius="4"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition x:Name="ColOeeAvailFilled" Width="92.5*"/>
                                            <ColumnDefinition x:Name="ColOeeAvailEmpty" Width="7.5*"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Background="#FFB020" CornerRadius="4"/>
                                    </Grid>
                                </Grid>
                            </StackPanel>
                            
                            <!-- Performance -->
                            <StackPanel Margin="0,0,0,18">
                                <Grid Margin="0,0,0,6">
                                    <TextBlock Name="TxtPerformanceFactor" Text="Performance (Hiệu suất)" Foreground="{DynamicResource TextSecondary}" FontSize="11.5" FontWeight="SemiBold"/>
                                    <TextBlock Name="TxtOeePerfVal" Text="97.20%" Foreground="#4FC3F7" FontSize="12.5" FontWeight="Bold" HorizontalAlignment="Right"/>
                                </Grid>
                                <Grid Height="8">
                                    <Border Background="{DynamicResource WindowBackground}" CornerRadius="4"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition x:Name="ColOeePerfFilled" Width="97.2*"/>
                                            <ColumnDefinition x:Name="ColOeePerfEmpty" Width="2.8*"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Background="#4FC3F7" CornerRadius="4"/>
                                    </Grid>
                                </Grid>
                            </StackPanel>
                            
                            <!-- Quality -->
                            <StackPanel>
                                <Grid Margin="0,0,0,6">
                                    <TextBlock Name="TxtQualityFactor" Text="Quality (Chất lượng)" Foreground="{DynamicResource TextSecondary}" FontSize="11.5" FontWeight="SemiBold"/>
                                    <TextBlock Name="TxtOeeQualVal" Text="99.24%" Foreground="#10B981" FontSize="12.5" FontWeight="Bold" HorizontalAlignment="Right"/>
                                </Grid>
                                <Grid Height="8">
                                    <Border Background="{DynamicResource WindowBackground}" CornerRadius="4"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition x:Name="ColOeeQualFilled" Width="99.24*"/>
                                            <ColumnDefinition x:Name="ColOeeQualEmpty" Width="0.76*"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Background="#10B981" CornerRadius="4"/>
                                    </Grid>
                                </Grid>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
