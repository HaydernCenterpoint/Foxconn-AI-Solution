<UserControl x:Class="PLC.Views.Guest.UnitHistoryPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      mc:Ignorable="d"
      Background="{DynamicResource WindowBackground}">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock Grid.Row="0"
                   x:Name="PageTitle"
                   Text="Lịch Sử Làm Hàng"
                   FontSize="{DynamicResource TitleFontSize}"
                   FontWeight="Bold"
                   Foreground="{DynamicResource TextPrimary}"
                   Margin="0,0,0,20"/>

        <!-- Filter Section -->
        <Border Grid.Row="1"
                Background="{DynamicResource PanelBackground}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="15"
                Margin="0,0,0,15">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="10"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- From Date -->
                <TextBlock Grid.Row="0" Grid.Column="0"
                           x:Name="TxtFromDate"
                           Text="Từ ngày:"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource TextPrimary}"
                           Margin="0,0,10,0"/>
                <DatePicker Grid.Row="0" Grid.Column="1"
                            x:Name="FromDatePicker"
                            Margin="0,0,20,0"/>

                <!-- To Date -->
                <TextBlock Grid.Row="0" Grid.Column="2"
                           x:Name="TxtToDate"
                           Text="Đến ngày:"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource TextPrimary}"
                           Margin="0,0,10,0"/>
                <DatePicker Grid.Row="0" Grid.Column="3"
                            x:Name="ToDatePicker"
                            Margin="0,0,20,0"/>

                <!-- Search Button -->
                <Button Grid.Row="0" Grid.Column="4"
                        x:Name="SearchButton"
                        Content="Tìm kiếm"
                        Click="SearchButton_Click"
                        Background="{DynamicResource AccentColor}"
                        Foreground="White"
                        Padding="20,8"
                        BorderThickness="0"
                        Cursor="Hand"/>

                <!-- Status Filter -->
                <TextBlock Grid.Row="2" Grid.Column="0"
                           x:Name="TxtStatusLabel"
                           Text="Trạng thái:"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource TextPrimary}"
                           Margin="0,0,10,0"/>
                <ComboBox Grid.Row="2" Grid.Column="1"
                          x:Name="StatusComboBox"
                          SelectionChanged="StatusComboBox_SelectionChanged"
                          Margin="0,0,20,0">
                    <ComboBoxItem Content="Tất cả" IsSelected="True" Tag=""/>
                    <ComboBoxItem Content="OK" Tag="OK"/>
                    <ComboBoxItem Content="NG" Tag="NG"/>
                    <ComboBoxItem Content="Đang làm" Tag="InProgress"/>
                </ComboBox>

                <!-- Statistics -->
                <StackPanel Grid.Row="2" Grid.Column="2" Grid.ColumnSpan="3"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right">
                    <TextBlock x:Name="TotalCountText"
                               Text="Tổng: 0"
                               Foreground="{DynamicResource TextPrimary}"
                               Margin="0,0,20,0"
                               VerticalAlignment="Center"/>
                    <TextBlock x:Name="OkCountText"
                               Text="OK: 0"
                               Foreground="{DynamicResource SuccessColor}"
                               Margin="0,0,20,0"
                               VerticalAlignment="Center"
                               FontWeight="Bold"/>
                    <TextBlock x:Name="NgCountText"
                               Text="NG: 0"
                               Foreground="{DynamicResource DangerColor}"
                               VerticalAlignment="Center"
                               FontWeight="Bold"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Data Grid -->
        <Border Grid.Row="2"
                Background="{DynamicResource PanelBackground}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="8">
            <DataGrid x:Name="UnitsDataGrid"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      SelectionMode="Single"
                      GridLinesVisibility="Horizontal"
                      HeadersVisibility="Column"
                      CanUserResizeRows="False"
                      CanUserReorderColumns="False"
                      Background="Transparent"
                      BorderThickness="0"
                      MouseDoubleClick="UnitsDataGrid_MouseDoubleClick">

                <DataGrid.Columns>
                    <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="60"/>
                    <DataGridTextColumn Header="Bắt đầu" Binding="{Binding StartTime, StringFormat='HH:mm:ss'}" Width="90"/>
                    <DataGridTextColumn Header="Kết thúc" Binding="{Binding EndTime, StringFormat='HH:mm:ss'}" Width="90"/>
                    <DataGridTextColumn Header="Thời gian (s)" Binding="{Binding CycleTimeSeconds, StringFormat='F1'}" Width="100"/>
                    <DataGridTextColumn Header="Lỗi" Binding="{Binding ErrorCount}" Width="60"/>
                    <DataGridTemplateColumn Header="Trạng thái" Width="100">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border CornerRadius="4" Padding="8,4">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="{DynamicResource SuccessLight}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Status}" Value="NG">
                                                    <Setter Property="Background" Value="{DynamicResource DangerLight}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Status}" Value="InProgress">
                                                    <Setter Property="Background" Value="{DynamicResource InfoLight}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="{Binding Status}"
                                               HorizontalAlignment="Center"
                                               FontWeight="Bold">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{DynamicResource SuccessColor}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Status}" Value="NG">
                                                        <Setter Property="Foreground" Value="{DynamicResource DangerColor}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Status}" Value="InProgress">
                                                        <Setter Property="Foreground" Value="{DynamicResource InfoColor}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Ca" Binding="{Binding ShiftName}" Width="80"/>
                    <DataGridTextColumn Header="Ngày" Binding="{Binding ShiftDate}" Width="100"/>
                </DataGrid.Columns>

                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow">
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource AccentLight}"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.RowStyle>
            </DataGrid>
        </Border>

        <!-- Detail Panel -->
        <Border Grid.Row="3"
                x:Name="DetailPanel"
                Background="{DynamicResource PanelBackground}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="15"
                Margin="0,15,0,0"
                Visibility="Collapsed">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock x:Name="DetailSectionTitle"
                               Text="Chi tiết sản phẩm"
                               FontWeight="Bold"
                               Foreground="{DynamicResource TextPrimary}"
                               Margin="0,0,0,10"/>
                    <TextBlock x:Name="DetailIdText"
                               Foreground="{DynamicResource TextSecondary}"/>
                    <TextBlock x:Name="DetailTimeText"
                               Foreground="{DynamicResource TextSecondary}"/>
                    <TextBlock x:Name="DetailCycleText"
                               Foreground="{DynamicResource TextSecondary}"/>
                </StackPanel>

                <StackPanel Grid.Column="1">
                    <TextBlock x:Name="DetailErrorSectionTitle"
                               Text="Thông tin lỗi"
                               FontWeight="Bold"
                               Foreground="{DynamicResource TextPrimary}"
                               Margin="0,0,0,10"/>
                    <TextBlock x:Name="DetailErrorCountText"
                               Foreground="{DynamicResource TextSecondary}"/>
                    <TextBlock x:Name="DetailQualityOKText"
                               Foreground="{DynamicResource TextSecondary}"/>
                    <TextBlock x:Name="DetailQualityNGText"
                               Foreground="{DynamicResource TextSecondary}"/>
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <TextBlock x:Name="DetailRobotSectionTitle"
                               Text="Robot"
                               FontWeight="Bold"
                               Foreground="{DynamicResource TextPrimary}"
                               Margin="0,0,0,10"/>
                    <TextBlock x:Name="DetailFrontRobotText"
                               Foreground="{DynamicResource TextSecondary}"/>
                    <TextBlock x:Name="DetailRearRobotText"
                               Foreground="{DynamicResource TextSecondary}"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
