<av:UserControl xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="PLC.Views.SystemLogView"
    Background="#00FFFFFF"
    xmlns="clr-namespace:PLC.Views;assembly=ClientPLC"
    xmlns:av="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:s="clr-namespace:System;assembly=mscorlib">
    <av:Grid
        Margin="15,15,15,15">
        <av:Grid.RowDefinitions>
            <av:RowDefinition
                Height="Auto" />
            <av:RowDefinition
                Height="*" />
        </av:Grid.RowDefinitions>
        <av:Grid
            Margin="0,0,0,15"
            av:Grid.Row="0">
            <av:Grid.ColumnDefinitions>
                <av:ColumnDefinition
                    Width="*" />
                <av:ColumnDefinition
                    Width="Auto" />
                <av:ColumnDefinition
                    Width="Auto" />
            </av:Grid.ColumnDefinitions>
            <av:TextBlock
                Text="NHẬT KÝ HỆ THỐNG (LOG)"
                FontWeight="Bold"
                FontSize="{av:DynamicResource TitleFontSize}"
                Foreground="{av:DynamicResource TextPrimary}"
                Name="TxtTitle"
                VerticalAlignment="Center"
                Visibility="Collapsed" />
            <av:CheckBox
                IsChecked="True"
                Foreground="{av:DynamicResource TextSecondary}"
                Name="ChkAutoScroll"
                Margin="0,0,15,0"
                VerticalAlignment="Center"
                av:Grid.Column="1">Tự động cuộn</av:CheckBox>
            <av:Button
                Name="BtnClear"
                av:Grid.Column="2">
                <av:Button.Style>
                    <av:Style
                        TargetType="av:Button">
                        <av:Style.Resources>
                            <av:ResourceDictionary />
                        </av:Style.Resources>
                        <av:Setter
                            Property="av:TextElement.FontFamily">
                            <av:Setter.Value>
                                <av:FontFamily>Segoe UI, Inter, Roboto, Arial</av:FontFamily>
                            </av:Setter.Value>
                        </av:Setter>
                        <av:Setter
                            Property="av:TextElement.FontSize">
                            <av:Setter.Value>
                                <av:DynamicResource
                                    ResourceKey="BaseFontSize" />
                            </av:Setter.Value>
                        </av:Setter>
                        <av:Setter
                            Property="av:Panel.Background">
                            <av:Setter.Value>
                                <av:DynamicResource
                                    ResourceKey="PanelBackground" />
                            </av:Setter.Value>
                        </av:Setter>
                        <av:Setter
                            Property="av:TextElement.Foreground">
                            <av:Setter.Value>
                                <av:DynamicResource
                                    ResourceKey="TextPrimary" />
                            </av:Setter.Value>
                        </av:Setter>
                        <av:Setter
                            Property="av:Border.BorderBrush">
                            <av:Setter.Value>
                                <av:DynamicResource
                                    ResourceKey="BorderBrush" />
                            </av:Setter.Value>
                        </av:Setter>
                        <av:Setter
                            Property="av:Border.BorderThickness">
                            <av:Setter.Value>
                                <av:Thickness>1,1,1,1</av:Thickness>
                            </av:Setter.Value>
                        </av:Setter>
                        <av:Setter
                            Property="av:FrameworkElement.Height">
                            <av:Setter.Value>
                                <s:Double>32</s:Double>
                            </av:Setter.Value>
                        </av:Setter>
                        <av:Setter
                            Property="av:Control.Padding">
                            <av:Setter.Value>
                                <av:Thickness>15,0,15,0</av:Thickness>
                            </av:Setter.Value>
                        </av:Setter>
                        <av:Setter
                            Property="av:FrameworkElement.Cursor">
                            <av:Setter.Value>
                                <av:Cursor>Hand</av:Cursor>
                            </av:Setter.Value>
                        </av:Setter>
                        <av:Setter
                            Property="av:Control.Template">
                            <av:Setter.Value>
                                <av:ControlTemplate
                                    TargetType="av:Button">
                                    <av:Border
                                        BorderThickness="{av:TemplateBinding av:Border.BorderThickness}"
                                        CornerRadius="4,4,4,4"
                                        BorderBrush="{av:TemplateBinding av:Border.BorderBrush}"
                                        Background="{av:TemplateBinding av:Panel.Background}"
                                        Name="border">
                                        <av:ContentPresenter
                                            Content="{av:TemplateBinding av:ContentControl.Content}"
                                            ContentTemplate="{av:TemplateBinding av:ContentControl.ContentTemplate}"
                                            ContentStringFormat="{av:TemplateBinding av:ContentControl.ContentStringFormat}"
                                            Margin="{av:TemplateBinding av:Control.Padding}"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center" />
                                    </av:Border>
                                    <av:ControlTemplate.Triggers>
                                        <av:Trigger
                                            Property="av:UIElement.IsMouseOver">
                                            <av:Setter
                                                Property="av:Panel.Background">
                                                <av:Setter.Value>
                                                    <av:DynamicResource
                                                        ResourceKey="SidebarBackground" />
                                                </av:Setter.Value>
                                            </av:Setter>
                                            <av:Trigger.Value>
                                                <s:Boolean>True</s:Boolean>
                                            </av:Trigger.Value>
                                        </av:Trigger>
                                        <av:Trigger
                                            Property="av:UIElement.IsEnabled">
                                            <av:Setter
                                                Property="av:UIElement.Opacity">
                                                <av:Setter.Value>
                                                    <s:Double>0.5</s:Double>
                                                </av:Setter.Value>
                                            </av:Setter>
                                            <av:Trigger.Value>
                                                <s:Boolean>False</s:Boolean>
                                            </av:Trigger.Value>
                                        </av:Trigger>
                                    </av:ControlTemplate.Triggers>
                                </av:ControlTemplate>
                            </av:Setter.Value>
                        </av:Setter>
                    </av:Style>
                </av:Button.Style>Xóa Nhật Ký</av:Button>
        </av:Grid>
        <av:Border
            BorderThickness="1"
            Padding="10,10,10,10"
            CornerRadius="10"
            BorderBrush="{av:DynamicResource BorderBrush}"
            Background="{av:DynamicResource PanelBackground}"
            av:Grid.Row="1">
            <av:RichTextBox
                IsReadOnly="True"
                VerticalScrollBarVisibility="Auto"
                BorderThickness="0"
                Background="Transparent"
                Foreground="{av:DynamicResource TextPrimary}"
                FontFamily="Consolas"
                FontSize="13"
                Name="TxtLog">
                <av:FlowDocument
                    LineHeight="20"
                    Name="LogDocument"
                    AllowDrop="True" />
            </av:RichTextBox>
        </av:Border>
    </av:Grid>
</av:UserControl>