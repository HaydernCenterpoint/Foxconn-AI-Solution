<UserControl x:Class="PLC.Views.ErrorHistoryPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Filter panel -->
        <Border BorderThickness="1" Padding="15" CornerRadius="4"
                BorderBrush="{DynamicResource BorderBrush}"
                Background="{DynamicResource PanelBackground}"
                Margin="0,0,0,15" Grid.Row="0">
            <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Margin="0,0,20,5" VerticalAlignment="Center">
                    <TextBlock Name="LblMachineFilter" Text="Máy:" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <ComboBox Name="CboMachineFilter" Width="150" Height="28"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,0,20,5" VerticalAlignment="Center">
                    <TextBlock Name="LblErrorCodeFilter" Text="Mã lỗi:" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBox Name="TxtErrorCodeFilter" Width="120" Height="28"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,0,20,5" VerticalAlignment="Center">
                    <TextBlock Name="LblStatusFilter" Text="Trạng thái:" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <ComboBox Name="CboStatusFilter" Width="120" Height="28">
                        <ComboBoxItem Name="CboItemAllStatus" Content="Tất cả" Tag="" IsSelected="True"/>
                        <ComboBoxItem Name="CboItemActiveStatus" Content="Hoạt động" Tag="Active"/>
                        <ComboBoxItem Name="CboItemResolvedStatus" Content="Đã khôi phục" Tag="Resolved"/>
                    </ComboBox>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,0,20,5" VerticalAlignment="Center">
                    <TextBlock Name="LblShiftFilter" Text="Ca:" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <ComboBox Name="CboShiftFilter" Width="120" Height="28">
                        <ComboBoxItem Name="CboItemAllShift" Content="Tất cả" Tag="" IsSelected="True"/>
                        <ComboBoxItem Name="CboItemDayShift" Content="Ca sáng" Tag="Day"/>
                        <ComboBoxItem Name="CboItemNightShift" Content="Ca tối" Tag="Night"/>
                    </ComboBox>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,0,20,5" VerticalAlignment="Center">
                    <TextBlock Name="LblFromDateFilter" Text="Từ ngày:" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <DatePicker Name="DpFromDateFilter" Width="130" Height="28"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,0,20,5" VerticalAlignment="Center">
                    <TextBlock Name="LblToDateFilter" Text="Đến ngày:" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <DatePicker Name="DpToDateFilter" Width="130" Height="28"/>
                </StackPanel>

                <Button Name="BtnQueryErrorHistory" Width="120" Height="30" Margin="0,0,10,5">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource IconSearch}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.8" Width="14" Height="14" Margin="0,0,8,0" VerticalAlignment="Center" Stretch="Uniform"/>
                        <TextBlock Name="TxtBtnQueryErrorHistory" Text="Tra cứu" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Name="BtnExportErrorHistory" Width="120" Height="30" Margin="0,0,0,5">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource IconLogOut}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.8" Width="14" Height="14" Margin="0,0,8,0" VerticalAlignment="Center" Stretch="Uniform"/>
                        <TextBlock Name="TxtBtnExportErrorHistory" Text="Xuất CSV" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </WrapPanel>
        </Border>

        <!-- Error History Grid -->
        <Border BorderThickness="1" CornerRadius="4"
                BorderBrush="{DynamicResource BorderBrush}"
                Background="{DynamicResource PanelBackground}"
                Grid.Row="1">
            <DataGrid Name="DgErrorHistory" AutoGenerateColumns="False" IsReadOnly="True" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Auto">
                <DataGrid.Columns>
                    <DataGridTextColumn x:Name="ColIndex" Header="STT" Binding="{Binding Index}" Width="60"/>
                    <DataGridTextColumn x:Name="ColMachineId" Header="Mã máy" Binding="{Binding MachineId}" Width="120"/>
                    <DataGridTextColumn x:Name="ColErrorCode" Header="Mã lỗi" Binding="{Binding ErrorCode}" Width="100"/>
                    <DataGridTextColumn x:Name="ColErrorName" Header="Tên lỗi" Binding="{Binding ErrorName}" Width="200"/>
                    <DataGridTextColumn x:Name="ColAddress" Header="Địa chỉ PLC" Binding="{Binding Address}" Width="100"/>
                    <DataGridTextColumn x:Name="ColSeverity" Header="Mức độ" Binding="{Binding Severity}" Width="100"/>
                    <DataGridTextColumn x:Name="ColStartedAt" Header="Thời gian bắt đầu" Binding="{Binding StartedAt}" Width="150"/>
                    <DataGridTextColumn x:Name="ColEndedAt" Header="Thời gian kết thúc" Binding="{Binding EndedAt}" Width="150"/>
                    <DataGridTextColumn x:Name="ColDuration" Header="Tổng thời gian lỗi" Binding="{Binding DurationText}" Width="120"/>
                    <DataGridTextColumn x:Name="ColStatus" Header="Trạng thái" Binding="{Binding StatusText}" Width="100"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</UserControl>
