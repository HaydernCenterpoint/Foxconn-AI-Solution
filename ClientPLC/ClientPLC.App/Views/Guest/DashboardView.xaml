<av:UserControl xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="PLC.Views.DashboardView"
    Background="{av:DynamicResource WindowBackground}"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:av="http://schemas.microsoft.com/winfx/2006/xaml/presentation">
    <av:Grid>
        <av:Grid.RowDefinitions>
            <av:RowDefinition Height="Auto" /> <!-- Row 0: Header (Collapsed) -->
            <av:RowDefinition Height="Auto" /> <!-- Row 1: KPI Cards (6 columns) -->
            <av:RowDefinition Height="50*" />    <!-- Row 2: Charts Row (2 columns) -->
            <av:RowDefinition Height="50*" />    <!-- Row 3: Bottom Row (2 columns) -->
        </av:Grid.RowDefinitions>

        <!-- 1. HEADER (COLLAPSED BY DEFAULT) -->
        <av:Border Grid.Row="0" Visibility="Collapsed" Background="{av:DynamicResource PanelBackground}" Padding="20,16,20,16"
                    BorderThickness="0,0,0,1" BorderBrush="{av:DynamicResource BorderBrush}">
            <av:Grid>
                <av:Grid.RowDefinitions>
                    <av:RowDefinition Height="Auto" />
                    <av:RowDefinition Height="Auto" />
                </av:Grid.RowDefinitions>
                <av:Grid Grid.Row="0" Margin="0,0,0,12">
                    <av:Grid.ColumnDefinitions>
                        <av:ColumnDefinition Width="*" />
                        <av:ColumnDefinition Width="Auto" />
                        <av:ColumnDefinition Width="*" />
                    </av:Grid.ColumnDefinitions>
                    <av:StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <av:Path Data="{av:StaticResource IconGauge}" Stroke="#18D7FF" StrokeThickness="2" Width="22" Height="22" Margin="0,0,8,0" VerticalAlignment="Center" Stretch="Uniform"/>
                        <av:TextBlock Text="FOXCONN FII" FontWeight="Black" FontSize="16" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                    </av:StackPanel>
                    <av:Grid Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="10,-10,10,-10">
                        <av:Border BorderBrush="{av:DynamicResource AccentColor}" BorderThickness="1,0,1,1" Background="{av:DynamicResource PanelBackground}" Padding="32,6,32,6" CornerRadius="0,0,12,12" Height="50" MinWidth="380" VerticalAlignment="Top">
                            <av:StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                <av:TextBlock Name="TxtTitle" Text="{av:Binding Title}" FontWeight="Bold" FontSize="17" Foreground="{av:DynamicResource TextPrimary}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <av:TextBlock Name="TxtLineNameSub" Text="{av:Binding LineName}" FontSize="11" Foreground="{av:DynamicResource AccentColor}" HorizontalAlignment="Center" FontWeight="SemiBold" Margin="0,1,0,0"/>
                            </av:StackPanel>
                        </av:Border>
                    </av:Grid>
                    <av:StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
                        <av:Border Name="BorderServerBadge" Background="{av:Binding ServerStatusBackground}" BorderBrush="{av:Binding ServerStatusBorder}" BorderThickness="1" CornerRadius="10" Padding="12,0,12,0" Height="36" Margin="0,0,8,0" VerticalAlignment="Center">
                            <av:StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <av:Path Data="{av:StaticResource IconServer}" Fill="{av:Binding ServerIconFill}" StrokeThickness="0" Width="14" Height="14" Margin="0,0,6,0" VerticalAlignment="Center" Stretch="Uniform" Name="IconServer"/>
                                <av:TextBlock Text="{av:Binding ServerStatusText}" FontWeight="Medium" FontSize="13" Foreground="{av:Binding ServerStatusForeground}" VerticalAlignment="Center" Name="TxtServerBadge"/>
                            </av:StackPanel>
                        </av:Border>
                        <av:Border Name="BorderPlcBadge" Background="{av:Binding PlcStatusBackground}" BorderBrush="{av:Binding PlcStatusBorder}" BorderThickness="1" CornerRadius="10" Padding="12,0,12,0" Height="36" Margin="0,0,12,0" VerticalAlignment="Center">
                            <av:StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <av:Path Data="{av:StaticResource IconPlug}" Stroke="{av:Binding PlcStatusForeground}" StrokeThickness="1.5" Width="14" Height="14" Margin="0,0,6,0" VerticalAlignment="Center" Stretch="Uniform" Name="IconPlc"/>
                                <av:TextBlock Text="{av:Binding PlcStatusText}" FontWeight="Medium" FontSize="13" Foreground="{av:Binding PlcStatusForeground}" VerticalAlignment="Center" Name="TxtPlcBadge"/>
                            </av:StackPanel>
                        </av:Border>
                        <av:Border Background="{av:DynamicResource WindowBackground}" BorderBrush="{av:DynamicResource BorderBrush}" BorderThickness="1" Padding="12,0,12,0" CornerRadius="10" Height="36" VerticalAlignment="Center">
                            <av:TextBlock Name="TxtTime" Text="{av:Binding CurrentTime}" FontFamily="Consolas, Courier New, monospace" FontWeight="SemiBold" FontSize="16" Foreground="{av:DynamicResource TextPrimary}" VerticalAlignment="Center"/>
                        </av:Border>
                    </av:StackPanel>
                </av:Grid>
                <av:StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,4,0,0">
                    <av:StackPanel Orientation="Horizontal" Margin="0,0,16,0">
                        <av:Path Data="{av:StaticResource IconCpu}" Stroke="{av:DynamicResource TextMuted}" StrokeThickness="1.5" Width="14" Height="14" Margin="0,0,6,0" VerticalAlignment="Center" Stretch="Uniform"/>
                        <av:TextBlock Name="TxtBadgeMachine" Text="{av:Binding MachineBadge}" FontSize="13" Foreground="{av:DynamicResource TextSecondary}" VerticalAlignment="Center"/>
                    </av:StackPanel>
                    <av:TextBlock Text="·" FontSize="16" FontWeight="Bold" Foreground="{av:DynamicResource BorderBrush}" VerticalAlignment="Center" Margin="0,0,16,0"/>
                    <av:StackPanel Orientation="Horizontal" Margin="0,0,16,0">
                        <av:Path Data="{av:StaticResource IconClock3}" Stroke="{av:DynamicResource TextMuted}" StrokeThickness="1.5" Width="14" Height="14" Margin="0,0,6,0" VerticalAlignment="Center" Stretch="Uniform"/>
                        <av:TextBlock Name="TxtBadgeShift" Text="{av:Binding ShiftBadge}" FontSize="13" Foreground="{av:DynamicResource TextSecondary}" VerticalAlignment="Center"/>
                    </av:StackPanel>
                    <av:TextBlock Text="·" FontSize="16" FontWeight="Bold" Foreground="{av:DynamicResource BorderBrush}" VerticalAlignment="Center" Margin="0,0,16,0"/>
                    <av:StackPanel Orientation="Horizontal" Margin="0,0,16,0">
                        <av:Path Data="{av:StaticResource IconCalendarDays}" Stroke="{av:DynamicResource TextMuted}" StrokeThickness="1.5" Width="14" Height="14" Margin="0,0,6,0" VerticalAlignment="Center" Stretch="Uniform"/>
                        <av:TextBlock Name="TxtBadgeDate" Text="{av:Binding DateBadge}" FontSize="13" Foreground="{av:DynamicResource TextSecondary}" VerticalAlignment="Center"/>
                    </av:StackPanel>
                    <av:TextBlock Text="·" FontSize="16" FontWeight="Bold" Foreground="{av:DynamicResource BorderBrush}" VerticalAlignment="Center" Margin="0,0,16,0"/>
                    <av:StackPanel Orientation="Horizontal">
                        <av:Path Data="{av:StaticResource IconTimer}" Stroke="{av:DynamicResource TextMuted}" StrokeThickness="1.5" Width="14" Height="14" Margin="0,0,6,0" VerticalAlignment="Center" Stretch="Uniform"/>
                        <av:TextBlock Name="TxtBadgeCycle" Text="{av:Binding CycleBadge}" FontSize="13" Foreground="{av:DynamicResource TextSecondary}" VerticalAlignment="Center"/>
                    </av:StackPanel>
                    <av:TextBlock Name="TxtSubtitle" Visibility="Collapsed"/>
                </av:StackPanel>
            </av:Grid>
        </av:Border>

        <!-- 2. KPI CARDS (5 COLUMNS) -->
        <av:UniformGrid Grid.Row="1" Columns="5" Margin="20,12,20,10">
            <!-- Card 1: Today's Production -->
            <av:Border Name="CardTodayBorder" Height="110" BorderThickness="1" CornerRadius="10" Padding="20,16" Margin="0,0,12,0">
                <av:Border.Style>
                    <av:Style TargetType="av:Border">
                        <av:Setter Property="BorderBrush" Value="{av:DynamicResource BorderBrush}"/>
                        <av:Setter Property="Background" Value="{av:DynamicResource PanelBackground}"/>
                        <av:Setter Property="Effect">
                            <av:Setter.Value>
                                <av:DropShadowEffect BlurRadius="8" ShadowDepth="1" Color="#000000" Opacity="0.06"/>
                            </av:Setter.Value>
                        </av:Setter>
                        <av:Style.Triggers>
                            <av:Trigger Property="IsMouseOver" Value="True">
                                <av:Setter Property="BorderBrush" Value="#10B981"/>
                                <av:Setter Property="Effect">
                                    <av:Setter.Value>
                                        <av:DropShadowEffect BlurRadius="14" ShadowDepth="2" Color="#10B981" Opacity="0.2"/>
                                    </av:Setter.Value>
                                </av:Setter>
                            </av:Trigger>
                        </av:Style.Triggers>
                    </av:Style>
                </av:Border.Style>
                <av:Grid>
                    <av:Grid.ColumnDefinitions>
                        <av:ColumnDefinition Width="Auto"/>
                        <av:ColumnDefinition Width="*"/>
                    </av:Grid.ColumnDefinitions>
                    
                    <!-- Futuristic Top Accent Line -->
                    <av:Border Height="3.5" CornerRadius="3,3,0,0" VerticalAlignment="Top" Grid.ColumnSpan="2" Margin="-20,-16,-20,0">
                        <av:Border.Background>
                            <av:LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <av:GradientStop Color="{av:DynamicResource KpiProductionColorVal}" Offset="0.0"/>
                                <av:GradientStop Color="{av:DynamicResource KpiProductionGradientEndVal}" Offset="1.0"/>
                            </av:LinearGradientBrush>
                        </av:Border.Background>
                    </av:Border>

                    <av:Border Width="50" Height="50" CornerRadius="25" Background="#100078D4" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <av:Border.Effect>
                            <av:DropShadowEffect BlurRadius="8" ShadowDepth="0" Color="#0078D4" Opacity="0.35"/>
                        </av:Border.Effect>
                        <av:Path Data="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z" Fill="Transparent" Stroke="{av:DynamicResource KpiProductionColor}" StrokeThickness="1.5" Width="24" Height="24" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </av:Border>
                    <av:StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                        <av:TextBlock Name="TxtTodayQtyTitle" Text="{av:Binding TodayQtyTitle}" FontSize="13.5" FontWeight="SemiBold" Foreground="{av:DynamicResource TextSecondary}"/>
                        <av:TextBlock Name="TxtTodayQty" Text="{av:Binding TodayQty}" FontSize="28" FontWeight="Bold" Foreground="{av:DynamicResource KpiProductionColor}" Margin="0,3,0,0"/>
                    </av:StackPanel>
                </av:Grid>
            </av:Border>

            <!-- Card 2: Yield (%) -->
            <av:Border Name="CardYieldBorder" Height="110" BorderThickness="1" CornerRadius="10" Padding="20,16" Margin="0,0,12,0">
                <av:Border.Style>
                    <av:Style TargetType="av:Border">
                        <av:Setter Property="BorderBrush" Value="{av:DynamicResource BorderBrush}"/>
                        <av:Setter Property="Background" Value="{av:DynamicResource PanelBackground}"/>
                        <av:Setter Property="Effect">
                            <av:Setter.Value>
                                <av:DropShadowEffect BlurRadius="8" ShadowDepth="1" Color="#000000" Opacity="0.06"/>
                            </av:Setter.Value>
                        </av:Setter>
                        <av:Style.Triggers>
                            <av:Trigger Property="IsMouseOver" Value="True">
                                <av:Setter Property="BorderBrush" Value="#10B981"/>
                                <av:Setter Property="Effect">
                                    <av:Setter.Value>
                                        <av:DropShadowEffect BlurRadius="14" ShadowDepth="2" Color="#10B981" Opacity="0.2"/>
                                    </av:Setter.Value>
                                </av:Setter>
                            </av:Trigger>
                        </av:Style.Triggers>
                    </av:Style>
                </av:Border.Style>
                <av:Grid>
                    <av:Grid.ColumnDefinitions>
                        <av:ColumnDefinition Width="Auto"/>
                        <av:ColumnDefinition Width="*"/>
                    </av:Grid.ColumnDefinitions>
                    
                    <!-- Futuristic Top Accent Line -->
                    <av:Border Height="3.5" CornerRadius="3,3,0,0" VerticalAlignment="Top" Grid.ColumnSpan="2" Margin="-20,-16,-20,0">
                        <av:Border.Background>
                            <av:LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <av:GradientStop Color="{av:DynamicResource KpiYieldColorVal}" Offset="0.0"/>
                                <av:GradientStop Color="{av:DynamicResource KpiYieldGradientEndVal}" Offset="1.0"/>
                            </av:LinearGradientBrush>
                        </av:Border.Background>
                    </av:Border>

                    <av:Border Width="50" Height="50" CornerRadius="25" Background="#1010B981" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <av:Border.Effect>
                            <av:DropShadowEffect BlurRadius="8" ShadowDepth="0" Color="#10B981" Opacity="0.35"/>
                        </av:Border.Effect>
                        <av:Path Data="M22 11.08V12a10 10 0 1 1-5.93-9.14 M22 4L12 14.01l-3-3" Fill="Transparent" Stroke="{av:DynamicResource KpiYieldColor}" StrokeThickness="1.5" Width="24" Height="24" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </av:Border>
                    <av:StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                        <av:TextBlock Name="TxtYieldTitle" Text="{av:Binding YieldTitle}" FontSize="13.5" FontWeight="SemiBold" Foreground="{av:DynamicResource TextSecondary}"/>
                        <av:TextBlock Name="TxtYieldValue" Text="{av:Binding YieldValue}" FontSize="28" FontWeight="Bold" Foreground="{av:DynamicResource KpiYieldColor}" Margin="0,3,0,0"/>
                    </av:StackPanel>
                </av:Grid>
            </av:Border>

            <!-- Card 3: UPH -->
            <av:Border Name="CardUphBorder" Height="110" BorderThickness="1" CornerRadius="10" Padding="20,16" Margin="0,0,12,0">
                <av:Border.Style>
                    <av:Style TargetType="av:Border">
                        <av:Setter Property="BorderBrush" Value="{av:DynamicResource BorderBrush}"/>
                        <av:Setter Property="Background" Value="{av:DynamicResource PanelBackground}"/>
                        <av:Setter Property="Effect">
                            <av:Setter.Value>
                                <av:DropShadowEffect BlurRadius="8" ShadowDepth="1" Color="#000000" Opacity="0.06"/>
                            </av:Setter.Value>
                        </av:Setter>
                        <av:Style.Triggers>
                            <av:Trigger Property="IsMouseOver" Value="True">
                                <av:Setter Property="BorderBrush" Value="{av:DynamicResource AccentColor}"/>
                                <av:Setter Property="Effect">
                                    <av:Setter.Value>
                                        <av:DropShadowEffect BlurRadius="14" ShadowDepth="2" Color="#0078D4" Opacity="0.25"/>
                                    </av:Setter.Value>
                                </av:Setter>
                            </av:Trigger>
                        </av:Style.Triggers>
                    </av:Style>
                </av:Border.Style>
                <av:Grid>
                    <av:Grid.ColumnDefinitions>
                        <av:ColumnDefinition Width="Auto"/>
                        <av:ColumnDefinition Width="*"/>
                    </av:Grid.ColumnDefinitions>
                    
                    <!-- Futuristic Top Accent Line -->
                    <av:Border Height="3.5" CornerRadius="3,3,0,0" VerticalAlignment="Top" Grid.ColumnSpan="2" Margin="-20,-16,-20,0">
                        <av:Border.Background>
                            <av:LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <av:GradientStop Color="{av:DynamicResource KpiUphColorVal}" Offset="0.0"/>
                                <av:GradientStop Color="{av:DynamicResource KpiUphGradientEndVal}" Offset="1.0"/>
                            </av:LinearGradientBrush>
                        </av:Border.Background>
                    </av:Border>

                    <av:Border Width="50" Height="50" CornerRadius="25" Background="#108764B8" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <av:Border.Effect>
                            <av:DropShadowEffect BlurRadius="8" ShadowDepth="0" Color="#8764B8" Opacity="0.35"/>
                        </av:Border.Effect>
                        <av:Path Data="M13 2L3 14h9l-1 8 10-12h-9l1-8z" Fill="Transparent" Stroke="{av:DynamicResource KpiUphColor}" StrokeThickness="1.5" Width="24" Height="24" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </av:Border>
                    <av:StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                        <av:TextBlock Name="TxtUphTitle" Text="{av:Binding UphTitle}" FontSize="13.5" FontWeight="SemiBold" Foreground="{av:DynamicResource TextSecondary}"/>
                        <av:TextBlock Name="TxtUphValue" Text="{av:Binding UphValue}" FontSize="28" FontWeight="Bold" Foreground="{av:DynamicResource KpiUphColor}" Margin="0,3,0,0"/>
                    </av:StackPanel>
                </av:Grid>
            </av:Border>

            <!-- Card 4: OEE (%) -->
            <av:Border Name="CardOeeBorder" Height="110" BorderThickness="1" CornerRadius="10" Padding="20,16" Margin="0,0,12,0">
                <av:Border.Style>
                    <av:Style TargetType="av:Border">
                        <av:Setter Property="BorderBrush" Value="{av:DynamicResource BorderBrush}"/>
                        <av:Setter Property="Background" Value="{av:DynamicResource PanelBackground}"/>
                        <av:Setter Property="Effect">
                            <av:Setter.Value>
                                <av:DropShadowEffect BlurRadius="8" ShadowDepth="1" Color="#000000" Opacity="0.06"/>
                            </av:Setter.Value>
                        </av:Setter>
                        <av:Style.Triggers>
                            <av:Trigger Property="IsMouseOver" Value="True">
                                <av:Setter Property="BorderBrush" Value="#10B981"/>
                                <av:Setter Property="Effect">
                                    <av:Setter.Value>
                                        <av:DropShadowEffect BlurRadius="14" ShadowDepth="2" Color="#10B981" Opacity="0.2"/>
                                    </av:Setter.Value>
                                </av:Setter>
                            </av:Trigger>
                        </av:Style.Triggers>
                    </av:Style>
                </av:Border.Style>
                <av:Grid>
                    <av:Grid.ColumnDefinitions>
                        <av:ColumnDefinition Width="Auto"/>
                        <av:ColumnDefinition Width="*"/>
                    </av:Grid.ColumnDefinitions>
                    
                    <!-- Futuristic Top Accent Line -->
                    <av:Border Height="3.5" CornerRadius="3,3,0,0" VerticalAlignment="Top" Grid.ColumnSpan="2" Margin="-20,-16,-20,0">
                        <av:Border.Background>
                            <av:LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <av:GradientStop Color="{av:DynamicResource KpiOeeColorVal}" Offset="0.0"/>
                                <av:GradientStop Color="{av:DynamicResource KpiOeeGradientEndVal}" Offset="1.0"/>
                            </av:LinearGradientBrush>
                        </av:Border.Background>
                    </av:Border>

                    <av:Border Width="50" Height="50" CornerRadius="25" Background="#10F59E0B" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <av:Border.Effect>
                            <av:DropShadowEffect BlurRadius="8" ShadowDepth="0" Color="#F59E0B" Opacity="0.35"/>
                        </av:Border.Effect>
                        <av:Path Data="M22 12h-4l-3 9L9 3l-3 9H2" Fill="Transparent" Stroke="{av:DynamicResource KpiOeeColor}" StrokeThickness="1.5" Width="24" Height="24" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </av:Border>
                    <av:StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                        <av:TextBlock Name="TxtOeeTitle" Text="{av:Binding OeeTitle}" FontSize="13.5" FontWeight="SemiBold" Foreground="{av:DynamicResource TextSecondary}"/>
                        <av:TextBlock Name="TxtOeeValue" Text="{av:Binding OeeValue}" FontSize="28" FontWeight="Bold" Foreground="{av:DynamicResource KpiOeeColor}" Margin="0,3,0,0"/>
                    </av:StackPanel>
                </av:Grid>
            </av:Border>

            <!-- Card 5: Total Alarms -->
            <av:Border Name="CardAlarmsBorder" Height="110" BorderThickness="1" CornerRadius="10" Padding="20,16" Margin="0">
                <av:Border.Style>
                    <av:Style TargetType="av:Border">
                        <av:Setter Property="BorderBrush" Value="{av:DynamicResource BorderBrush}"/>
                        <av:Setter Property="Background" Value="{av:DynamicResource PanelBackground}"/>
                        <av:Setter Property="Effect">
                            <av:Setter.Value>
                                <av:DropShadowEffect BlurRadius="8" ShadowDepth="1" Color="#000000" Opacity="0.06"/>
                            </av:Setter.Value>
                        </av:Setter>
                        <av:Style.Triggers>
                            <av:Trigger Property="IsMouseOver" Value="True">
                                <av:Setter Property="BorderBrush" Value="#EF4444"/>
                                <av:Setter Property="Effect">
                                    <av:Setter.Value>
                                        <av:DropShadowEffect BlurRadius="14" ShadowDepth="2" Color="#EF4444" Opacity="0.2"/>
                                    </av:Setter.Value>
                                </av:Setter>
                            </av:Trigger>
                        </av:Style.Triggers>
                    </av:Style>
                </av:Border.Style>
                <av:Grid>
                    <av:Grid.ColumnDefinitions>
                        <av:ColumnDefinition Width="Auto"/>
                        <av:ColumnDefinition Width="*"/>
                    </av:Grid.ColumnDefinitions>
                    
                    <!-- Futuristic Top Accent Line -->
                    <av:Border Height="3.5" CornerRadius="3,3,0,0" VerticalAlignment="Top" Grid.ColumnSpan="2" Margin="-20,-16,-20,0">
                        <av:Border.Background>
                            <av:LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <av:GradientStop Color="{av:DynamicResource KpiAlarmColorVal}" Offset="0.0"/>
                                <av:GradientStop Color="{av:DynamicResource KpiAlarmGradientEndVal}" Offset="1.0"/>
                            </av:LinearGradientBrush>
                        </av:Border.Background>
                    </av:Border>

                    <av:Border Width="50" Height="50" CornerRadius="25" Background="#10EF4444" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <av:Border.Effect>
                            <av:DropShadowEffect BlurRadius="8" ShadowDepth="0" Color="#EF4444" Opacity="0.35"/>
                        </av:Border.Effect>
                        <av:Path Data="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z M12 9v4 M12 17h.01" Fill="Transparent" Stroke="{av:DynamicResource KpiAlarmColor}" StrokeThickness="1.5" Width="24" Height="24" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </av:Border>
                    <av:StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                        <av:TextBlock Name="TxtAlarmsTitle" Text="{av:Binding AlarmsTitle}" FontSize="13.5" FontWeight="SemiBold" Foreground="{av:DynamicResource TextSecondary}"/>
                        <av:TextBlock Name="TxtAlarmsCount" Text="{av:Binding AlarmsCount}" FontSize="28" FontWeight="Bold" Foreground="{av:DynamicResource KpiAlarmColor}" Margin="0,3,0,0"/>
                    </av:StackPanel>
                </av:Grid>
            </av:Border>
        </av:UniformGrid>

        <!-- 3. LINE CHARTS ROW (2 COLUMNS) -->
        <av:Grid Grid.Row="2" Margin="20,0,20,10">
            <av:Grid.ColumnDefinitions>
                <av:ColumnDefinition Width="*" />
                <av:ColumnDefinition Width="*" />
            </av:Grid.ColumnDefinitions>
            <!-- Production Trend Chart -->
            <av:Border Grid.Column="0" Background="{av:DynamicResource PanelBackground}" BorderBrush="{av:DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="16,12,16,12" Margin="0,0,8,0">
                <av:Border.Effect>
                    <av:DropShadowEffect BlurRadius="8" ShadowDepth="1" Color="#000000" Opacity="0.06"/>
                </av:Border.Effect>
                <av:Grid>
                    <av:Grid.RowDefinitions>
                        <av:RowDefinition Height="Auto" />
                        <av:RowDefinition Height="*" />
                        <av:RowDefinition Height="Auto" />
                    </av:Grid.RowDefinitions>
                    
                    <av:Grid Grid.Row="0" Margin="0,0,0,6">
                        <av:Grid.ColumnDefinitions>
                            <av:ColumnDefinition Width="*" />
                            <av:ColumnDefinition Width="Auto" />
                        </av:Grid.ColumnDefinitions>
                        <av:TextBlock Name="TxtProductionChartTitle" Text="{av:Binding ProductionChartTitle}" FontSize="14.5" FontWeight="Bold" Foreground="{av:DynamicResource TextPrimary}" Grid.Column="0"/>
                        <av:StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <av:Line X1="0" Y1="0" X2="14" Y2="0" Stroke="{av:DynamicResource AccentColor}" StrokeThickness="2" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <av:TextBlock Name="TxtTodayLegend1" Text="{av:Binding TodayLegend1}" FontSize="11" Foreground="{av:DynamicResource TextSecondary}"/>
                        </av:StackPanel>
                    </av:Grid>

                    <av:Canvas Grid.Row="1" Name="ProductionChartCanvas" Background="Transparent" Margin="8,4,8,4" />
                    <av:UniformGrid Grid.Row="2" Name="GridProductionXAxis" Columns="7" Margin="42,2,12,0"/>
                </av:Grid>
            </av:Border>

            <!-- Yield Trend Chart -->
            <av:Border Grid.Column="1" Background="{av:DynamicResource PanelBackground}" BorderBrush="{av:DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="16,12,16,12" Margin="8,0,0,0">
                <av:Border.Effect>
                    <av:DropShadowEffect BlurRadius="8" ShadowDepth="1" Color="#000000" Opacity="0.06"/>
                </av:Border.Effect>
                <av:Grid>
                    <av:Grid.RowDefinitions>
                        <av:RowDefinition Height="Auto" />
                        <av:RowDefinition Height="*" />
                        <av:RowDefinition Height="Auto" />
                    </av:Grid.RowDefinitions>
                    
                    <av:Grid Grid.Row="0" Margin="0,0,0,6">
                        <av:Grid.ColumnDefinitions>
                            <av:ColumnDefinition Width="*" />
                            <av:ColumnDefinition Width="Auto" />
                        </av:Grid.ColumnDefinitions>
                        <av:TextBlock Name="TxtYieldChartTitle" Text="{av:Binding YieldChartTitle}" FontSize="14.5" FontWeight="Bold" Foreground="{av:DynamicResource TextPrimary}" Grid.Column="0"/>
                        <av:StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <av:Line X1="0" Y1="0" X2="14" Y2="0" Stroke="{av:DynamicResource AccentColor}" StrokeThickness="2" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <av:TextBlock Name="TxtTodayLegend2" Text="{av:Binding TodayLegend2}" FontSize="11" Foreground="{av:DynamicResource TextSecondary}"/>
                        </av:StackPanel>
                    </av:Grid>

                    <av:Canvas Grid.Row="1" Name="YieldChartCanvas" Background="Transparent" Margin="8,4,8,4" />
                    <av:UniformGrid Grid.Row="2" Name="GridYieldXAxis" Columns="7" Margin="42,2,12,0"/>
                </av:Grid>
            </av:Border>
        </av:Grid>

        <!-- 4. BOTTOM ROW: TABLE & HOURLY PRODUCTION (50/50 SPLIT) -->
        <av:Grid Grid.Row="3" Margin="20,0,20,16">
            <av:Grid.ColumnDefinitions>
                <av:ColumnDefinition Width="*" />
                <av:ColumnDefinition Width="*" />
            </av:Grid.ColumnDefinitions>

            <!-- Top 5 Alarms Table -->
            <av:Border Grid.Column="0" Background="{av:DynamicResource PanelBackground}" BorderBrush="{av:DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="16,12,16,12" Margin="0,0,8,0">
                <av:Border.Effect>
                    <av:DropShadowEffect BlurRadius="8" ShadowDepth="1" Color="#000000" Opacity="0.06"/>
                </av:Border.Effect>
                <av:Grid>
                    <av:Grid.RowDefinitions>
                        <av:RowDefinition Height="Auto" />
                        <av:RowDefinition Height="*" />
                    </av:Grid.RowDefinitions>

                    <av:TextBlock Name="TxtTopAlarmsTitle" Text="{av:Binding TopAlarmsTitle}" FontSize="14.5" FontWeight="Bold" Foreground="{av:DynamicResource TextPrimary}" Grid.Row="0" Margin="0,0,0,6"/>

                    <Grid Grid.Row="1">
                        <!-- Top 5 Alarms Grid -->
                        <av:Grid Name="GridAlarmsTable" VerticalAlignment="Stretch">
                            <av:Grid.Style>
                                <av:Style TargetType="av:Grid">
                                    <av:Setter Property="Visibility" Value="Visible"/>
                                    <av:Style.Triggers>
                                        <av:DataTrigger Binding="{av:Binding TopAlarmDevice1}" Value="">
                                            <av:Setter Property="Visibility" Value="Collapsed"/>
                                        </av:DataTrigger>
                                        <av:DataTrigger Binding="{av:Binding TopAlarmDevice1}" Value="{x:Null}">
                                            <av:Setter Property="Visibility" Value="Collapsed"/>
                                        </av:DataTrigger>
                                    </av:Style.Triggers>
                                </av:Style>
                            </av:Grid.Style>
                            <av:Grid.ColumnDefinitions>
                                <av:ColumnDefinition Width="50" />
                                <av:ColumnDefinition Width="*" />
                                <av:ColumnDefinition Width="80" />
                                <av:ColumnDefinition Width="120" />
                            </av:Grid.ColumnDefinitions>
                            <av:Grid.RowDefinitions>
                                <av:RowDefinition Height="*" />
                                <av:RowDefinition Height="*" />
                                <av:RowDefinition Height="*" />
                                <av:RowDefinition Height="*" />
                                <av:RowDefinition Height="*" />
                                <av:RowDefinition Height="*" />
                            </av:Grid.RowDefinitions>

                            <!-- Header Row -->
                            <av:Border Grid.Row="0" Grid.ColumnSpan="4" BorderBrush="{av:DynamicResource BorderBrush}" BorderThickness="0,0,0,1.2" VerticalAlignment="Bottom" Margin="0,0,0,2"/>
                            <av:TextBlock Name="TxtColRank" Text="{av:Binding ColRank}" Grid.Row="0" Grid.Column="0" FontSize="11.5" FontWeight="Bold" Foreground="{av:DynamicResource TextSecondary}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                            <av:TextBlock Name="TxtColDevice" Text="{av:Binding ColDevice}" Grid.Row="0" Grid.Column="1" FontSize="11.5" FontWeight="Bold" Foreground="{av:DynamicResource TextSecondary}" VerticalAlignment="Center" HorizontalAlignment="Left" Padding="8,0,0,0"/>
                            <av:TextBlock Name="TxtColCount" Text="{av:Binding ColCount}" Grid.Row="0" Grid.Column="2" FontSize="11.5" FontWeight="Bold" Foreground="{av:DynamicResource TextSecondary}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                            <av:TextBlock Name="TxtColDuration" Text="{av:Binding ColDuration}" Grid.Row="0" Grid.Column="3" FontSize="11.5" FontWeight="Bold" Foreground="{av:DynamicResource TextSecondary}" VerticalAlignment="Center" HorizontalAlignment="Center"/>

                            <!-- Row 1 -->
                            <av:Border Grid.Row="1" Grid.ColumnSpan="4" BorderBrush="{av:DynamicResource BorderBrush}" BorderThickness="0,0,0,0.8" VerticalAlignment="Bottom" Opacity="0.4"/>
                            <av:TextBlock Name="TxtAlarmRank1" Text="1" Grid.Row="1" Grid.Column="0" FontSize="11.5" Foreground="{av:DynamicResource TextPrimary}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                            <av:TextBlock Name="TxtAlarmDevice1" Text="{av:Binding TopAlarmDevice1}" Grid.Row="1" Grid.Column="1" FontSize="11.5" Foreground="{av:DynamicResource TextPrimary}" VerticalAlignment="Center" HorizontalAlignment="Left" Padding="8,0,0,0"/>
                            <av:TextBlock Name="TxtAlarmCount1" Text="{av:Binding TopAlarmCount1}" Grid.Row="1" Grid.Column="2" FontSize="11.5" Foreground="{av:DynamicResource TextPrimary}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                            <av:TextBlock Name="TxtAlarmDuration1" Text="{av:Binding TopAlarmDuration1}" Grid.Row="1" Grid.Column="3" FontSize="11.5" Foreground="{av:DynamicResource TextPrimary}" VerticalAlignment="Center" HorizontalAlignment="Center"/>

                            <!-- Row 2 -->
                            <av:Border Grid.Row="2" Grid.ColumnSpan="4" BorderBrush="{av:DynamicResource BorderBrush}" BorderThickness="0,0,0,0.8" VerticalAlignment="Bottom" Opacity="0.4"/>
                            <av:TextBlock Name="TxtAlarmRank2" Text="2" Grid.Row="2" Grid.Column="0" FontSize="11.5" Foreground="{av:DynamicResource TextPrimary}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                            <av:TextBlock Name="TxtAlarmDevice2" Text="{av:Binding TopAlarmDevice2}" Grid.Row="2" Grid.Column="1" FontSize="11.5" Foreground="{av:DynamicResource TextPrimary}" VerticalAlignment="Center" HorizontalAlignment="Left" Padding="8,0,0,0"/>
                            <av:TextBlock Name="TxtAlarmCount2" Text="{av:Binding TopAlarmCount2}" Grid.Row="2" Grid.Column="2" FontSize="11.5" Foreground="{av:DynamicResource TextPrimary}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                            <av:TextBlock Name="TxtAlarmDuration2" Text="{av:Binding TopAlarmDuration2}" Grid.Row="2" Grid.Column="3" FontSize="11.5" Foreground="{av:DynamicResource TextPrimary}" VerticalAlignment="Center" HorizontalAlignment="Center"/>

                            <!-- Row 3 -->
                            <av:Border Grid.Row="3" Grid.ColumnSpan="4" BorderBrush="{av:DynamicResource BorderBrush}" BorderThickness="0,0,0,0.8" VerticalAlignment="Bottom" Opacity="0.4"/>
                            <av:TextBlock Name="TxtAlarmRank3" Text="3" Grid.Row="3" Grid.Column="0" FontSize="11.5" Foreground="{av:DynamicResource TextPrimary}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                            <av:TextBlock Name="TxtAlarmDevice3" Text="{av:Binding TopAlarmDevice3}" Grid.Row="3" Grid.Column="1" FontSize="11.5" Foreground="{av:DynamicResource TextPrimary}" VerticalAlignment="Center" HorizontalAlignment="Left" Padding="8,0,0,0"/>
                            <av:TextBlock Name="TxtAlarmCount3" Text="{av:Binding TopAlarmCount3}" Grid.Row="3" Grid.Column="2" FontSize="11.5" Foreground="{av:DynamicResource TextPrimary}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                            <av:TextBlock Name="TxtAlarmDuration3" Text="{av:Binding TopAlarmDuration3}" Grid.Row="3" Grid.Column="3" FontSize="11.5" Foreground="{av:DynamicResource TextPrimary}" VerticalAlignment="Center" HorizontalAlignment="Center"/>

                            <!-- Row 4 -->
                            <av:Border Grid.Row="4" Grid.ColumnSpan="4" BorderBrush="{av:DynamicResource BorderBrush}" BorderThickness="0,0,0,0.8" VerticalAlignment="Bottom" Opacity="0.4"/>
                            <av:TextBlock Name="TxtAlarmRank4" Text="4" Grid.Row="4" Grid.Column="0" FontSize="11.5" Foreground="{av:DynamicResource TextPrimary}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                            <av:TextBlock Name="TxtAlarmDevice4" Text="{av:Binding TopAlarmDevice4}" Grid.Row="4" Grid.Column="1" FontSize="11.5" Foreground="{av:DynamicResource TextPrimary}" VerticalAlignment="Center" HorizontalAlignment="Left" Padding="8,0,0,0"/>
                            <av:TextBlock Name="TxtAlarmCount4" Text="{av:Binding TopAlarmCount4}" Grid.Row="4" Grid.Column="2" FontSize="11.5" Foreground="{av:DynamicResource TextPrimary}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                            <av:TextBlock Name="TxtAlarmDuration4" Text="{av:Binding TopAlarmDuration4}" Grid.Row="4" Grid.Column="3" FontSize="11.5" Foreground="{av:DynamicResource TextPrimary}" VerticalAlignment="Center" HorizontalAlignment="Center"/>

                            <!-- Row 5 -->
                            <av:Border Grid.Row="5" Grid.ColumnSpan="4" BorderBrush="{av:DynamicResource BorderBrush}" BorderThickness="0,0,0,0.8" VerticalAlignment="Bottom" Opacity="0.4"/>
                            <av:TextBlock Name="TxtAlarmRank5" Text="5" Grid.Row="5" Grid.Column="0" FontSize="11.5" Foreground="{av:DynamicResource TextPrimary}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                            <av:TextBlock Name="TxtAlarmDevice5" Text="{av:Binding TopAlarmDevice5}" Grid.Row="5" Grid.Column="1" FontSize="11.5" Foreground="{av:DynamicResource TextPrimary}" VerticalAlignment="Center" HorizontalAlignment="Left" Padding="8,0,0,0"/>
                            <av:TextBlock Name="TxtAlarmCount5" Text="{av:Binding TopAlarmCount5}" Grid.Row="5" Grid.Column="2" FontSize="11.5" Foreground="{av:DynamicResource TextPrimary}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                            <av:TextBlock Name="TxtAlarmDuration5" Text="{av:Binding TopAlarmDuration5}" Grid.Row="5" Grid.Column="3" FontSize="11.5" Foreground="{av:DynamicResource TextPrimary}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </av:Grid>

                        <!-- Empty State Panel -->
                        <av:StackPanel Name="EmptyStatePanel" VerticalAlignment="Center" HorizontalAlignment="Center">
                            <av:StackPanel.Style>
                                <av:Style TargetType="av:StackPanel">
                                    <av:Setter Property="Visibility" Value="Collapsed"/>
                                    <av:Style.Triggers>
                                        <av:DataTrigger Binding="{av:Binding TopAlarmDevice1}" Value="">
                                            <av:Setter Property="Visibility" Value="Visible"/>
                                        </av:DataTrigger>
                                        <av:DataTrigger Binding="{av:Binding TopAlarmDevice1}" Value="{x:Null}">
                                            <av:Setter Property="Visibility" Value="Visible"/>
                                        </av:DataTrigger>
                                    </av:Style.Triggers>
                                </av:Style>
                            </av:StackPanel.Style>
                            <av:Path Data="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 15h-2v-6h2v6zm0-8h-2V7h2v2z" 
                                     Fill="{DynamicResource TextMuted}" Width="32" Height="32" Stretch="Uniform" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                            <av:TextBlock Name="TxtEmptyState" Text="{av:Binding NoDataText}" Foreground="{DynamicResource TextMuted}" FontSize="13" HorizontalAlignment="Center"/>
                        </av:StackPanel>
                    </Grid>
                </av:Grid>
            </av:Border>

            <!-- Hourly Production Bar Chart -->
            <av:Border Grid.Column="1" Background="{av:DynamicResource PanelBackground}" BorderBrush="{av:DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="16,12,16,12" Margin="8,0,0,0">
                <av:Border.Effect>
                    <av:DropShadowEffect BlurRadius="8" ShadowDepth="1" Color="#000000" Opacity="0.06"/>
                </av:Border.Effect>
                <av:Grid>
                    <av:Grid.RowDefinitions>
                        <av:RowDefinition Height="Auto" />
                        <av:RowDefinition Height="*" />
                        <av:RowDefinition Height="Auto" />
                    </av:Grid.RowDefinitions>

                    <!-- Header -->
                    <av:Grid Grid.Row="0" Margin="0,0,0,6">
                        <av:Grid.ColumnDefinitions>
                            <av:ColumnDefinition Width="*" />
                            <av:ColumnDefinition Width="Auto" />
                        </av:Grid.ColumnDefinitions>
                        <av:TextBlock Name="TxtHourlyOutputTitle" Text="{av:Binding HourlyOutputTitle}" FontSize="14.5" FontWeight="Bold" Foreground="{av:DynamicResource TextPrimary}" Grid.Column="0" VerticalAlignment="Center"/>
                        <av:StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <av:Rectangle Width="12" Height="12" Fill="{av:DynamicResource SuccessColor}" RadiusX="2" RadiusY="2" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <av:TextBlock Name="TxtHourlyOutputLegend" Text="{av:Binding HourlyOutputLegend}" FontSize="11" Foreground="{av:DynamicResource TextSecondary}"/>
                        </av:StackPanel>
                    </av:Grid>

                    <!-- Chart Canvas -->
                    <av:Canvas Grid.Row="1" Name="HourlyOutputCanvas" Background="Transparent" Margin="8,4,8,4" />

                    <!-- X-Axis Grid Labels -->
                    <av:UniformGrid Grid.Row="2" Name="GridHourlyOutputXAxis" Columns="12" Margin="42,2,12,0"/>
                </av:Grid>
            </av:Border>
        </av:Grid>
    </av:Grid>
</av:UserControl>
