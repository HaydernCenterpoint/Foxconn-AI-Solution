# Dockerfile for MKZ Sync Service
FROM python:3.11-slim

WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Install Python dependencies
COPY requirements.txt /app/
RUN pip install --no-cache-dir -r requirements.txt

# The exporter's normal VectorRAG path imports the local source package. The
# optional persisted custom-embedding configuration can also decrypt a saved
# endpoint key through core.platform_compat, so keep both packages available.
COPY scripts /app/scripts
COPY src /app/src
COPY core /app/core
ENV PYTHONPATH=/app

# Create data directory
RUN mkdir -p /app/data/mkz_exports

# Run sync script
CMD ["python", "-m", "scripts.sync_mkz_to_odysseus"]
