# ===========================================
# FII Factory + Odysseus development integration
# Copy to .env and replace only the placeholder values locally.
# Do not commit a populated .env file.
# ===========================================

# ===== AI provider =====
# Used only by Odysseus when it calls the selected AI provider.
# Keep this key on the Odysseus server; never place it in the frontend or MCP config.
# OPENAI_API_KEY=replace_with_your_provider_key

# ===== FII backend REST bridge =====
# This is the data source for factory questions. It is separate from OPENAI_API_KEY.
MKZ_BACKEND_URL=http://127.0.0.1:5165

# Optional. Leave blank for the current local development backend when its read
# endpoints do not require authentication. Use a least-privilege read-only token
# when the backend enforces authentication.
MKZ_BACKEND_TOKEN=

# ===== Odysseus development settings =====
AUTH_ENABLED=true
APP_BIND=127.0.0.1
APP_PORT=7000
DATABASE_URL=sqlite:///./data/app.db

# ===== Vector memory / RAG =====
CHROMADB_HOST=localhost
CHROMADB_PORT=8100

# Local-development workaround for a FastEmbed first-run download that can
# hang when Hugging Face Xet is used. This belongs to Odysseus, not ChromaDB.
HF_HUB_DISABLE_XET=1

# ===== Optional web search =====
SEARXNG_INSTANCE=http://localhost:8080
