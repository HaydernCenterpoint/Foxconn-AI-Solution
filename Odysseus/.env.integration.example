# ===========================================
# MKZ Factory + Odysseus Integration
# Environment Configuration
# ===========================================

# ===== MKZ Database Connection =====
# These settings connect to the MKZ PostgreSQL database

MKZ_DB_HOST=localhost
MKZ_DB_PORT=5432
MKZ_DB_NAME=plc_monitoring
MKZ_DB_USER=postgres
MKZ_DB_PASSWORD=12345678

# ===== Sync Settings =====
# How often to sync data (in hours)
SYNC_INTERVAL_HOURS=1

# How long to keep sync exports (in days)
SYNC_RETENTION_DAYS=30

# ===== Odysseus Settings =====
# Basic auth (set to true for production)
AUTH_ENABLED=true

# Bind address (use 0.0.0.0 for LAN access)
APP_BIND=127.0.0.1
APP_PORT=7000

# Database (SQLite for Odysseus)
DATABASE_URL=sqlite:///./data/app.db

# ChromaDB for vector memory
CHROMADB_HOST=localhost
CHROMADB_PORT=8100

# SearXNG for web search
SEARXNG_INSTANCE=http://localhost:8080

# ===== Security (IMPORTANT: Change these for production!) =====

# JWT Secret for authentication
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=SUPER_SECRET_KEY_FOR_PRODUCTION_CHANGE_ME

# ===== Production Overrides =====
# Uncomment and fill for production deployment

# JWT_SECRET=your-generated-jwt-secret-here
# AUTH_ENABLED=true
# APP_BIND=0.0.0.0
