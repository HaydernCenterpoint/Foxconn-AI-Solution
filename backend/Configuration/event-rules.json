{
  "$schema": "event-rules-schema",
  "version": 1,
  "description": "Sample CEP event rules for MKZ Factory — Week 1-2 deliverable",
  "rules": [
    {
      "id": "rule-temp-critical",
      "name": "Temperature Critical Threshold",
      "description": "Fires when machine temperature exceeds 85°C",
      "enabled": true,
      "eventType": "THRESHOLD_BREACH",
      "severity": "CRITICAL",
      "condition": {
        "type": "threshold",
        "metric": "temperature",
        "operator": ">",
        "value": 85,
        "unit": "°C"
      },
      "cooldownSeconds": 300
    },
    {
      "id": "rule-temp-warning",
      "name": "Temperature Warning",
      "description": "Fires when machine temperature exceeds 70°C",
      "enabled": true,
      "eventType": "THRESHOLD_BREACH",
      "severity": "WARNING",
      "condition": {
        "type": "threshold",
        "metric": "temperature",
        "operator": ">",
        "value": 70,
        "unit": "°C"
      },
      "cooldownSeconds": 600
    },
    {
      "id": "rule-vibration-high",
      "name": "High Vibration Alert",
      "description": "Fires when vibration sensor reading exceeds 350 Hz",
      "enabled": true,
      "eventType": "THRESHOLD_BREACH",
      "severity": "WARNING",
      "condition": {
        "type": "threshold",
        "metric": "vibration",
        "operator": ">",
        "value": 350,
        "unit": "Hz"
      },
      "cooldownSeconds": 300
    },
    {
      "id": "rule-pressure-low",
      "name": "Low Pressure Alert",
      "description": "Fires when pressure drops below 1.0 bar",
      "enabled": true,
      "eventType": "THRESHOLD_BREACH",
      "severity": "CRITICAL",
      "condition": {
        "type": "threshold",
        "metric": "pressure",
        "operator": "<",
        "value": 1.0,
        "unit": "bar"
      },
      "cooldownSeconds": 300
    },
    {
      "id": "rule-multi-machine-error",
      "name": "Multi-Machine Error Correlation",
      "description": "Fires when 3+ machines on the same line report errors within 5 minutes",
      "enabled": true,
      "eventType": "ALARM",
      "severity": "EMERGENCY",
      "condition": {
        "type": "correlation",
        "scope": "production_line",
        "event": "status_change_to_error",
        "threshold": 3,
        "windowSeconds": 300
      },
      "cooldownSeconds": 600
    },
    {
      "id": "rule-production-drop",
      "name": "Production Drop >20%",
      "description": "Fires when hourly production drops more than 20% compared to same hour yesterday",
      "enabled": true,
      "eventType": "PRODUCTION_MILESTONE",
      "severity": "WARNING",
      "condition": {
        "type": "comparison",
        "metric": "production_quantity",
        "compareWith": "same_hour_yesterday",
        "operator": "drop_percent_gt",
        "value": 20
      },
      "cooldownSeconds": 3600
    },
    {
      "id": "rule-oee-low",
      "name": "Low OEE Alert",
      "description": "Fires when machine OEE drops below 65%",
      "enabled": true,
      "eventType": "THRESHOLD_BREACH",
      "severity": "WARNING",
      "condition": {
        "type": "threshold",
        "metric": "oee",
        "operator": "<",
        "value": 65,
        "unit": "%"
      },
      "cooldownSeconds": 1800
    },
    {
      "id": "rule-maintenance-overdue",
      "name": "Maintenance Overdue",
      "description": "Fires when machine runtime exceeds maintenance interval (500 hours) without service record",
      "enabled": true,
      "eventType": "MAINTENANCE_DUE",
      "severity": "WARNING",
      "condition": {
        "type": "runtime_threshold",
        "metric": "uptime_seconds",
        "operator": ">",
        "value": 1800000,
        "note": "500 hours = 1,800,000 seconds"
      },
      "cooldownSeconds": 86400
    },
    {
      "id": "rule-yield-critical",
      "name": "Yield Rate Critical Drop",
      "description": "Fires when yield rate drops below 90%",
      "enabled": true,
      "eventType": "THRESHOLD_BREACH",
      "severity": "CRITICAL",
      "condition": {
        "type": "threshold",
        "metric": "yield_rate",
        "operator": "<",
        "value": 90,
        "unit": "%"
      },
      "cooldownSeconds": 600
    },
    {
      "id": "rule-cpu-high",
      "name": "High CPU Usage",
      "description": "Fires when machine controller CPU exceeds 90%",
      "enabled": true,
      "eventType": "THRESHOLD_BREACH",
      "severity": "WARNING",
      "condition": {
        "type": "threshold",
        "metric": "cpu_percent",
        "operator": ">",
        "value": 90,
        "unit": "%"
      },
      "cooldownSeconds": 300
    }
  ]
}
