{
    "Logging": {
        "LogLevel": {
            "Default": "Information",
            "Microsoft.AspNetCore": "Warning"
        }
    },
    "AllowedHosts": "*",
    "Jwt": {},
    "ConnectionStrings": {
        "DefaultConnection": "Host=localhost;Port=5432;Database=plc_monitoring;Username=postgres;Include Error Detail=true",
        "Timescale": "Host=localhost;Port=55433;Database=plc_timescale;Username=postgres"
    },
    "FiiSso": {
        "SecureCookie": false,
        "CookieDomain": ""
    },
    "MqttServer": {
        "Tls": {
            "Enabled": false
        }
    },
    "Timescale": {
        "Enabled": false,
        "BackfillBatchSize": 1000,
        "RawRetentionDays": 30,
        "AggregateRetentionDays": 365,
        "ColumnstoreAfterDays": 7,
        "AggregateRefreshWindowDays": 29
    },
    "CepStaging": {
        "Enabled": false,
        "BaseUrl": "http://localhost:58085",
        "RequestTimeoutSeconds": 5,
        "QueueCapacity": 1000
    },
    "TcpServer": {
        "Port": 7001
    },
    "HealthScoring": {
        "IntervalMinutes": 15
    },
    "BatchPrediction": {
        "IntervalMinutes": 15,
        "InitialDelaySeconds": 45,
        "MaxAssets": 1000,
        "FailureRiskWindow": "1h"
    },
    "Mqtt": {}
}
